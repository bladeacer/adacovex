       & ASCII.LF
       & "<tr><td><code>prove</code></td><td><code>false</code></td><td>Run GNATprove "
       & "before assessing, for repos that don"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "t commit <code>gnatprove.out</code></td></tr>"
       & ASCII.LF
       & "<tr><td><code>require-spark</code></td><td><code>''</code></td><td>Minimum S"

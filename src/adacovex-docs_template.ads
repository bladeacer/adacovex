       & ASCII.LF
       & "                        <h1 id=""low-level-requirements--adacovex""><a class="""
       & "header"" href=""#low-level-requirements--adacovex"">Low-Level Requirements "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " adacovex</a></h1>"
       & ASCII.LF
       & "<h2 id=""llr-mapping""><a class=""header"" href=""#llr-mapping"">LLR Mapping</a></"
       & "h2>"
       & ASCII.LF
       & "<ul>"
       & ASCII.LF
       & "<li>LLR-ARCH-01: <code>alire.toml</code> shall declare project metadata [HLR"
       & "-ARCH]</li>"
       & ASCII.LF
       & "<li>LLR-ARCH-02: <code>Makefile</code> shall provide build, prove, fmt, lint"
       & ", api-docs, changelog targets [HLR-ARCH]</li>"
       & ASCII.LF
       & "<li>LLR-ARCH-03: <code>adacovex.gpr</code> shall compile all sources with <c"
       & "ode>-gnatwa</code> warnings [HLR-ARCH]</li>"
       & ASCII.LF
       & "<li>LLR-SCAN-01: Scan_Project shall walk directories recursively. It shall s"
       & "kip .git and obj [HLR-SCAN]</li>"
       & ASCII.LF
       & "<li>LLR-SCAN-02: Scan_Ads_File shall extract procedure, function, and generi"
       & "c declarations [HLR-SCAN]</li>"
       & ASCII.LF
       & "<li>LLR-SCAN-03: Scan_Ads_File shall find "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " HLR-XXXX tags in source [HLR-SCAN]</li>"
       & ASCII.LF
       & "<li>LLR-SCAN-04: Scan_Ads_File shall find @param, @return, @field, @formal d"
       & "ocstring tags [HLR-SCAN]</li>"
       & ASCII.LF
       & "<li>LLR-PROOF-01: Parse_Prove_Out shall parse gnatprove.out and extract VC c"
       & "ounts per check type [HLR-PROOF]</li>"
       & ASCII.LF
       & "<li>LLR-PROOF-02: Determine_SPARK_Level shall assign level based on proved/u"
       & "nproved ratios [HLR-PROOF]</li>"
       & ASCII.LF
       & "<li>LLR-TEST-01: Parse_Test_Result shall parse Markdown test results for pas"
       & "s/fail counts [HLR-TEST]</li>"
       & ASCII.LF
       & "<li>LLR-TEST-02: Parse_Test_Stdout shall parse raw test runner stdout for pa"
       & "ss/fail counts [HLR-TEST]</li>"
       & ASCII.LF
       & "<li>LLR-DAL-01: Assess_DAL_C shall make sure that all HLRs are traced in sou"
       & "rce [HLR-COMPLIANCE] [HLR-DAL-C]</li>"
       & ASCII.LF
       & "<li>LLR-DAL-02: Assess_DAL_C shall find orphan tags that do not match any HL"
       & "R [HLR-COMPLIANCE] [HLR-DAL-C]</li>"
       & ASCII.LF
       & "<li>LLR-DAL-03: Assess_DAL_C shall make sure that test results show zero fai"
       & "lures [HLR-COMPLIANCE] [HLR-DAL-C]</li>"
       & ASCII.LF
       & "<li>LLR-DAL-04: Assess_DAL_C shall make sure that SPARK level is &gt;= Bronz"
       & "e [HLR-COMPLIANCE] [HLR-DAL-C]</li>"
       & ASCII.LF
       & "<li>LLR-DAL-05: Assess_DAL_A shall require SPARK Gold + tests passing + all "
       & "HLRs + no orphans [HLR-DAL-A]</li>"
       & ASCII.LF
       & "<li>LLR-DAL-06: Assess_DAL_B shall require SPARK Silver + tests passing + al"
       & "l HLRs + no orphans [HLR-DAL-B]</li>"
       & ASCII.LF
       & "<li>LLR-DAL-07: Assess_DAL_D shall require tests passing + all HLRs [HLR-DAL"
       & "-D]</li>"
       & ASCII.LF
       & "<li>LLR-DAL-08: Assess_DAL_E shall require all HLRs [HLR-DAL-E]</li>"
       & ASCII.LF
       & "<li>LLR-RENDER-ANSI-01: Render_Summary shall output colour-highlighted termi"
       & "nal report [HLR-RENDER-ANSI]</li>"
       & ASCII.LF
       & "<li>LLR-RENDER-SVG-01: Render_SPARK_Badge shall produce valid SVG with level"
       & " colour [HLR-RENDER-SVG]</li>"
       & ASCII.LF
       & "<li>LLR-RENDER-SVG-02: Render_Tests_Badge shall show passed/failed in green/"
       & "red [HLR-RENDER-SVG]</li>"
       & ASCII.LF
       & "<li>LLR-RENDER-SVG-03: Render_DO178C_Badge shall show Achieved/Unmet in gree"
       & "n/red [HLR-RENDER-SVG]</li>"
       & ASCII.LF
       & "<li>LLR-RENDER-MD-01: Generate_Verification_Report shall write coverage, pro"
       & "of, test, compliance tables [HLR-RENDER-MD]</li>"
       & ASCII.LF
       & "<li>LLR-RENDER-MD-02: Generate_Trace_Matrix shall map each package to its HL"
       & "R tags [HLR-RENDER-MD]</li>"
       & ASCII.LF
       & "<li>LLR-RENDER-HTML-01: Render_Dashboard shall produce self-contained HTML w"
       & "ith embedded CSS [HLR-RENDER-HTML]</li>"
       & ASCII.LF
       & "<li>LLR-RENDER-HTML-02: Render_Metrics_JSON shall produce JSON with key metr"
       & "ics [HLR-RENDER-HTML]</li>"
       & ASCII.LF
       & "<li>LLR-SERVER-01: Start shall bind to port and serve dashboard at /, API at"
       & " /api/metrics, badges at /badge/*.svg [HLR-SERVER]</li>"
       & ASCII.LF
       & "<li>LLR-CLI-01: Parse_CLI shall parse "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "target, "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "dal, "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "serve, "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "port, "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "emit-svg, "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "emit-markdown [HLR-CLI]</li>"
       & ASCII.LF
       & "<li>LLR-CLI-02: Parse_CLI shall default target to the current working direct"
       & "ory and DAL to C [HLR-CLI]</li>"
       & ASCII.LF
       & "</ul>"

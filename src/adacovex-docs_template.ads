       & "</a></h3>"
       & ASCII.LF
       & "<div class=""table-wrapper colwidths-auto docutils container"">"
       & ASCII.LF
       & "<table class=""docutils align-default"">"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr class=""row-odd""><th class=""head""><p>DAL</p></th>"
       & ASCII.LF
       & "<th class=""head""><p>Requirement</p></th>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p>A"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "B</p></td>"
       & ASCII.LF
       & "<td><p>100% tests passing with MC/DC coverage (structural coverage analysis)"
       & "</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-odd""><td><p>C</p></td>"
       & ASCII.LF
       & "<td><p>100% tests passing (statement coverage)</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p>D</p></td>"
       & ASCII.LF
       & "<td><p>100% tests passing</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-odd""><td><p>E</p></td>"
       & ASCII.LF
       & "<td><p>No requirement</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "</tbody>"
       & ASCII.LF
       & "</table>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""minimum-spark-level"">"
       & ASCII.LF
       & "<h3>4. Minimum SPARK Level<a class=""headerlink"" href=""#minimum-spark-level"" "
       & "title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<div class=""table-wrapper colwidths-auto docutils container"">"
       & ASCII.LF
       & "<table class=""docutils align-default"">"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr class=""row-odd""><th class=""head""><p>DAL</p></th>"
       & ASCII.LF
       & "<th class=""head""><p>Minimum SPARK Level</p></th>"

       & ASCII.LF
       & "<tr><td>Change the dashboard page</td><td>Edit <code>resources/dashboard.htm"
       & "l</code> (plain HTML/CSS/JS), then run <code>tools/gen-dashboard.py</code> t"
       & "o regenerate <code>src/adacovex-dashboard_template.ads</code></td></tr>"
       & ASCII.LF
       & "<tr><td>Change assessment criteria</td><td><code>src/compliance/adacovex-com"
       & "pliance-dal.adb</code> (+ the DAL levels doc)</td></tr>"
       & ASCII.LF
       & "<tr><td>Add tests</td><td><code>src/tests/</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " see below</td></tr>"
       & ASCII.LF
       & "<tr><td>Regenerate API docs</td><td><code>make doc</code> (gnatdoc -&gt; <co"
       & "de>tools/rst2md.py</code> -&gt; <code>docs/api-docs/</code>)</td></tr>"
       & ASCII.LF
       & "<tr><td>Regenerate the offline manual</td><td><code>make book</code> (mdBook"
       & " -&gt; <code>tools/gen-docs.py</code> -&gt; <code>src/adacovex-docs_template"
       & ".ads</code>)</td></tr>"
       & ASCII.LF
       & "<tr><td>Sync test counts</td><td><code>make test-count</code> (reads <code>d"
       & "ocs/test_result.md</code>, rewrites every anchored count)</td></tr>"
       & ASCII.LF
       & "<tr><td>Sync proof metrics</td><td><code>make proof-status</code></td></tr>"
       & ASCII.LF
       & "<tr><td>Regenerate AGENTS.md blocks</td><td><code>make agents-tree</code> (s"
       & "rc tree) and <code>make doc-links</code> (docs list)</td></tr>"
       & ASCII.LF
       & "<tr><td>Verify markdown links</td><td><code>make link-check</code></td></tr>"
       & ASCII.LF
       & "</tbody>"

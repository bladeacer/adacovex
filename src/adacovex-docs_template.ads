       & "pan class=""n"">Proof_Summary</span> <span class=""p"">(</span><span class=""n"">V"
       & "C</span> <span class=""n"">counts</span><span class=""p"">,</span> <span class="""
       & "n"">SPARK</span> <span class=""n"">level</span><span class=""p"">)</span>"
       & ASCII.LF
       & "<span class=""mf"">7.</span> <span class=""n"">Parse</span> <span class=""n"">test"
       & "</span> <span class=""n"">results</span>       <span class=""o"">-&gt;</span> <s"
       & "pan class=""n"">Test_Summary</span> <span class=""p"">(</span><span class=""k"">pa"
       & "ss</span><span class=""o"">/</span><span class=""n"">fail</span> <span class=""n"""
       & ">counts</span><span class=""p"">)</span>"
       & ASCII.LF
       & "<span class=""mf"">8.</span> <span class=""n"">Assess</span> <span class=""n"">DAL"
       & "</span> <span class=""n"">compliance</span>    <span class=""o"">-&gt;</span> <s"
       & "pan class=""n"">DAL_Assessment</span> <span class=""p"">(</span><span class=""n"">"

                  & ASCII.LF
                  & "                        <h1 id=""adacovex-documentation""><a class=""header"" hr"
                  & "ef=""#adacovex-documentation"">adacovex Documentation</a></h1>"
                  & ASCII.LF
                  & "<p>This page is the index for all adacovex documentation.  Pick a section fo"
                  & "r"
                  & ASCII.LF
                  & "your role, or read the pages in the order below.</p>"
                  & ASCII.LF
                  & "<p>All documentation uses British English and ASD-STE100 Simplified Technica"
                  & "l"
                  & ASCII.LF
                  & "English.  The controlled Technical Names dictionary lives in"
                  & ASCII.LF
                  & "<a href=""ste100-technical-names.html"">STE100 Technical Names</a>.  Use it be"
                  & "fore you use"
                  & ASCII.LF
                  & "a technical word in any doc, docstring, or changelog.</p>"
                  & ASCII.LF
                  & "<h2 id=""for-end-users""><a class=""header"" href=""#for-end-users"">For end users"
                  & "</a></h2>"
                  & ASCII.LF
                  & "<ul>"
                  & ASCII.LF
                  & "<li><a href=""installation.html"">Installation</a> "
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(147)
                  & " install the binary or the GitHub"
                  & ASCII.LF
                  & "Action.</li>"
                  & ASCII.LF
                  & "<li><a href=""cli-reference.html"">CLI reference</a> "
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(147)
                  & " every command, flag, and exit code.</li>"
                  & ASCII.LF
                  & "<li><a href=""target-projects.html"">Target projects</a> "
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(147)
                  & " what a target project must"
                  & ASCII.LF
                  & "contain.</li>"
                  & ASCII.LF
                  & "<li><a href=""dashboard.html"">Web dashboard</a> "
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(147)
                  & " the HTML report and JSON API.</li>"
                  & ASCII.LF
                  & "<li><a href=""sbom.html"">SBOM</a> "
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(147)
                  & " the software-bill-of-materials generator.</li>"
                  & ASCII.LF
                  & "<li><a href=""standards.html"">Standards</a> "
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(147)
                  & " DO-178C, ISO 26262, and IEC 62304 levels.</li>"
                  & ASCII.LF
                  & "<li><a href=""platforms.html"">Platforms</a> "
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(147)
                  & " supported platforms and toolchain state.</li>"
                  & ASCII.LF
                  & "<li><a href=""vcs.html"">VCS support</a> "
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(147)
                  & " differential assessment across git, hg, svn,"
                  & ASCII.LF
                  & "fossil, and jj.</li>"
                  & ASCII.LF

       & ASCII.LF
       & "        <template id=fa-copy><span class=fa-svg><svg xmlns=""http://www.w3.or"
       & "g/2000/svg"" viewBox=""0 0 512 512""><!--! Font Awesome Free 6.2.0 by @fontawes"

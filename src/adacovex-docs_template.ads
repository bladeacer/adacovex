       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<p>End-user pages no longer reference <code class=""docutils literal notransl"
       & "ate""><span class=""pre"">make</span></code>/dev targets: <code class=""docutils"
       & " literal notranslate""><span class=""pre"">ci-cd.md</span></code> scopes"

       & "y"":""# Self-assessment (strict mode, 100% docs required)\\nadacovex --target="
       & ". # ISO 26262 assessment at ASIL B (dedicated flag)\\nadacovex --target=. --"
       & "asil=B # IEC 62304 assessment at safety Class A (dedicated flag)\\nadacovex "
       & "--target=. --class=A # ISO 26262 assessment at rigour tier C (ASIL B) via --"
       & "standard\\nadacovex --target=. --standard=iso26262 --dal=C # Emit badges for"
       & " every standard at the shared tier\\nadacovex --target=. --standard=all # Re"
       & "port toolchain + platform status\\nadacovex status --target=. # Assess a CRD"
       & "T library at DAL-C in relaxed mode\\nadacovex --target=../Ada_CRDT --dal=C -"
       & "-relaxed # DAL-A assessment (requires Gold SPARK)\\nadacovex --target=. --da"
       & "l=A # Without SVG output\\nadacovex --target=../Ada_CRDT --no-svg # Custom s"
       & "kip dirs\\nadacovex --target=../Ada_CRDT --relaxed --skip-dir=vendor # With "
       & "Markdown reports\\nadacovex --target=. --emit-markdown=docs/compliance # Web"
       & " dashboard on custom port\\nadacovex --target=. --serve --port=9090 # Differ"
       & "ential assessment vs a git base revision\\nadacovex --target=. --compare-bas"
       & "e=HEAD # Proof-aware SBOM (CycloneDX 1.5 JSON; all standards by default)\\na"
       & "dacovex sbom --format=cyclonedx-json --target=. --dal=C\\n# SBOM for a singl"
       & "e standard (ISO 26262 at ASIL B)\\nadacovex sbom --format=cyclonedx-json --t"
       & "arget=. --asil=B\\n# SPDX 2.3 SBOM at IEC 62304 Class A\\nadacovex sbom --fo"
       & "rmat=spdx-json --target=. --class=A --out=sbom.spdx.json # Proof-aware SBOM "
       & "(SPDX 2.3 JSON) at a custom path\\nadacovex sbom --format=spdx-json --out=do"

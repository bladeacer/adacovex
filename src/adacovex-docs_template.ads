--  Generated by tools/gen-docs.py from the Sphinx manual (docs/):
--  the whole built site (pages, stylesheets, scripts, badges, search)
--  as a gzip-compressed, base64-encoded offline asset blob + lookup
--  table.  --serve exposes it at /docs/ with Content-Encoding: gzip
--  (the browser inflates it).  Do not edit by hand; edit docs/ and
--  run make book.
package Adacovex.Docs_Template is

   --  One entry of the lookup table.  The path and MIME type
   --  are fixed-size (space-padded) strings; Idx selects the
   --  first body of the asset via Asset_Bodies; Gzip says the
   --  body holds base64 gzip bytes served with Content-Encoding:
   --  gzip.  Fixed-size components keep the aggregate a plain
   --  static constant (a discriminated-record array is
   --  dynamically elaborated by GNAT and blows the heap).
   Max_Path : constant := 80;
   Max_Mime : constant := 32;
   Asset_Count : constant := 206;
   subtype Asset_Index is Positive range 1 .. Asset_Count;
   Body_Count : constant := 206;
   subtype Body_Index is Positive range 1 .. Body_Count;
   type Asset_Ref is
      record
         Path  : String (1 .. Max_Path) := (others => ' ');
         Mime  : String (1 .. Max_Mime) := (others => ' ');
         Idx   : Body_Index;
         Gzip  : Boolean;
      end record;

   type Asset_Table is array (Positive range <>) of Asset_Ref;


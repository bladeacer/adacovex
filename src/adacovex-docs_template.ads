   Asset_148 : aliased constant String :=
       "// Populate the sidebar"
       & ASCII.LF
       & "//"
       & ASCII.LF
       & "// This is a script, and not included directly in the page, to control the t"
       & "otal size of the book."
       & ASCII.LF
       & "// The TOC contains an entry for each page, so if each page includes a copy "
       & "of the TOC,"
       & ASCII.LF
       & "// the total size of the page becomes O(n**2)."
       & ASCII.LF
       & "class MDBookSidebarScrollbox extends HTMLElement {"
       & ASCII.LF
       & "    constructor() {"
       & ASCII.LF
       & "        super();"
       & ASCII.LF
       & "    }"
       & ASCII.LF

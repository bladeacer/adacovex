       & ASCII.LF
       & "Total_LOC  : Natural := 0;"
       & ASCII.LF
       & "Violations : Violation_Vectors.Vector;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF

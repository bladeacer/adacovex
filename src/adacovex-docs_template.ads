  & ASCII.LF
  & "<p>These are optional but improve the workflow.</p>"
  & ASCII.LF
  & "<div class=""table-wrapper"">"
  & ASCII.LF
  & "<table>"
  & ASCII.LF
  & "<thead>"
  & ASCII.LF
  & "<tr><th>Dependency</th><th>Category</th><th>Managed by</th><"

       & ASCII.LF
       & "                        <h1 id=""adacovextarget_profiles""><a class=""header"" h"
       & "ref=""#adacovextarget_profiles"">Adacovex.Target_Profiles</a></h1>"
       & ASCII.LF
       & "<p>Signed two"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s-complement fixed-width integer types.  Each carries an"
       & ASCII.LF
       & "explicit Size.  IR values map one-to-one onto target machine types.</p>"
       & ASCII.LF
       & "<blockquote>"
       & ASCII.LF
       & "<p><strong>Note:</strong> All items in this package are public.</p>"
       & ASCII.LF
       & "</blockquote>"
       & ASCII.LF
       & "<h2 id=""types""><a class=""header"" href=""#types"">Types</a></h2>"
       & ASCII.LF
       & "<h3 id=""type-ir_int16""><a class=""header"" href=""#type-ir_int16"">type IR_Int16"
       & "</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type IR_Int16 is range -2**15 .. 2**15 - 1 w"
       & "ith Size =&gt; 16;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-ir_int32""><a class=""header"" href=""#type-ir_int32"">type IR_Int32"
       & "</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type IR_Int32 is range -2**31 .. 2**31 - 1 w"
       & "ith Size =&gt; 32;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-ir_int64""><a class=""header"" href=""#type-ir_int64"">type IR_Int64"
       & "</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type IR_Int64 is range -2**63 .. 2**63 - 1 w"
       & "ith Size =&gt; 64;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-ir_int8""><a class=""header"" href=""#type-ir_int8"">type IR_Int8</a"
       & "></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type IR_Int8 is range -2**7 .. 2**7 - 1 with"
       & " Size =&gt; 8;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-ir_uint16""><a class=""header"" href=""#type-ir_uint16"">type IR_UIn"
       & "t16</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type IR_UInt16 is mod 2**16;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-ir_uint32""><a class=""header"" href=""#type-ir_uint32"">type IR_UIn"
       & "t32</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type IR_UInt32 is mod 2**32;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-ir_uint64""><a class=""header"" href=""#type-ir_uint64"">type IR_UIn"
       & "t64</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type IR_UInt64 is mod 2**64;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-ir_uint8""><a class=""header"" href=""#type-ir_uint8"">type IR_UInt8"
       & "</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type IR_UInt8 is mod 2**8;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-target_config""><a class=""header"" href=""#type-target_config"">typ"
       & "e Target_Config</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type Target_Config is record"
       & ASCII.LF
       & "Host_Bits    : Word_Size := Bits_64;"
       & ASCII.LF
       & "Target_Bits  : Word_Size := Bits_64;"
       & ASCII.LF
       & "Pointer_Bits : Word_Size := Bits_64;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-word_size""><a class=""header"" href=""#type-word_size"">type Word_S"
       & "ize</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type Word_Size is (Bits_8, Bits_16, Bits_32,"
       & " Bits_64);"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF

       & ASCII.LF
       & "<code class=""docutils literal notranslate""><span class=""pre"">Post</span> <sp"
       & "an class=""pre"">=&gt;</span> <span class=""pre"">Result</span> <span class=""pre"
       & """>=</span> <span class=""pre"">Types.To_String</span> <span class=""pre"">(Level"
       & ")</span></code>.</p></li>"
       & ASCII.LF
       & "<li><p><strong>String assembly extracted</strong> into a body-level <code cl"
       & "ass=""docutils literal notranslate""><span class=""pre"">Assemble_ISO</span></co"
       & "de> helper with a"
       & ASCII.LF

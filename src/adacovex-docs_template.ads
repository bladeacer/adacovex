       & "          <section id=""adacovex-complexity"">"
       & ASCII.LF
       & "<h1>Adacovex.Complexity<a class=""headerlink"" href=""#adacovex-complexity"" tit"
       & "le=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h1>"
       & ASCII.LF
       & "<p>Cyclomatic complexity checker for Ada source files. It scans a target dir"
       & "ectory for .ads/.adb files. It computes per-file and per-subprogram cyclomat"
       & "ic complexity. It enforces configurable LOC and complexity gates. The implem"
       & "entation is native Ada with no external dependencies. HLR-COMPLEXITY: Cyclom"
       & "atic complexity analysis</p>"
       & ASCII.LF
       & "<blockquote>"
       & ASCII.LF
       & "<div><p><strong>Note:</strong> All items in this package are public.</p>"
       & ASCII.LF
       & "</div></blockquote>"
       & ASCII.LF
       & "<section id=""types"">"
       & ASCII.LF
       & "<h2>Types<a class=""headerlink"" href=""#types"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h2>"
       & ASCII.LF
       & "<section id=""type-complexity-result"">"
       & ASCII.LF
       & "<h3>type Complexity_Result<a class=""headerlink"" href=""#type-complexity-resul"
       & "t"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<div class=""highlight-ada notranslate""><div class=""highlight""><pre><span></s"
       & "pan><span class=""kd"">type</span> <span class=""kt"">Complexity_Result</span> <"
       & "span class=""kr"">is</span> <span class=""kr"">record</span>"
       & ASCII.LF
       & "<span class=""n"">Files</span>      <span class=""p"">:</span> <span class=""n"">F"
       & "ile_Vectors</span><span class=""p"">.</span><span class=""n"">Vector</span><span"
       & " class=""p"">;</span>"
       & ASCII.LF
       & "<span class=""n"">Total_LOC</span>  <span class=""p"">:</span> <span class=""kt"">"
       & "Natural</span> <span class=""p"">:=</span> <span class=""mi"">0</span><span clas"
       & "s=""p"">;</span>"
       & ASCII.LF
       & "<span class=""n"">Violations</span> <span class=""p"">:</span> <span class=""n"">V"
       & "iolation_Vectors</span><span class=""p"">.</span><span class=""n"">Vector</span>"
       & "<span class=""p"">;</span>"
       & ASCII.LF
       & "<span class=""kr"">end record</span><span class=""p"">;</span>"
       & ASCII.LF
       & "</pre></div>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""type-file-metrics"">"
       & ASCII.LF
       & "<h3>type File_Metrics<a class=""headerlink"" href=""#type-file-metrics"" title="""
       & "Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<div class=""highlight-ada notranslate""><div class=""highlight""><pre><span></s"
       & "pan><span class=""kd"">type</span> <span class=""kt"">File_Metrics</span> <span "
       & "class=""kr"">is</span> <span class=""kr"">record</span>"
       & ASCII.LF
       & "<span class=""n"">Path</span>          <span class=""p"">:</span> <span class=""k"
       & "t"">String</span> <span class=""p"">(</span><span class=""mi"">1</span> <span cla"
       & "ss=""p"">..</span> <span class=""mi"">4096</span><span class=""p"">);</span>"
       & ASCII.LF
       & "<span class=""n"">Path_Len</span>      <span class=""p"">:</span> <span class=""k"
       & "t"">Natural</span> <span class=""p"">:=</span> <span class=""mi"">0</span><span c"
       & "lass=""p"">;</span>"
       & ASCII.LF
       & "<span class=""n"">LOC</span>           <span class=""p"">:</span> <span class=""k"
       & "t"">Natural</span> <span class=""p"">:=</span> <span class=""mi"">0</span><span c"
       & "lass=""p"">;</span>"

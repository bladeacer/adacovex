       & ASCII.LF
       & "                        <h1 id=""dependencies""><a class=""header"" href=""#depen"
       & "dencies"">Dependencies</a></h1>"
       & ASCII.LF
       & "<p>This table groups adacovex dependencies by category. Alire-managed"
       & ASCII.LF
       & "dependencies are listed under their Alire crate names.</p>"
       & ASCII.LF
       & "<h2 id=""core""><a class=""header"" href=""#core"">Core</a></h2>"
       & ASCII.LF
       & "<p>These are required to build or run adacovex.</p>"
       & ASCII.LF
       & "<div class=""table-wrapper"">"
       & ASCII.LF
       & "<table>"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr><th>Dependency</th><th>Category</th><th>Managed by</th><th>Notes</th></t"
       & "r>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr><td>GNAT runtime</td><td>Core</td><td>GNAT toolchain</td><td>Required. N"
       & "o other library is needed.</td></tr>"
       & ASCII.LF
       & "<tr><td>GNAT compiler</td><td>Core</td><td>GNAT toolchain</td><td>Required f"
       & "or build.</td></tr>"
       & ASCII.LF
       & "<tr><td>gnatprove</td><td>Core</td><td>Alire (dev) or PATH</td><td>Required "
       & "for <code>covex prove</code>. Resolved at run time.</td></tr>"
       & ASCII.LF
       & "</tbody>"
       & ASCII.LF
       & "</table>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "<h2 id=""development""><a class=""header"" href=""#development"">Development</a></"
       & "h2>"
       & ASCII.LF
       & "<p>These are required to develop, test, or document adacovex.</p>"
       & ASCII.LF
       & "<div class=""table-wrapper"">"
       & ASCII.LF
       & "<table>"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr><th>Dependency</th><th>Category</th><th>Managed by</th><th>Notes</th></t"
       & "r>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr><td>Alire (<code>alr</code>)</td><td>Development</td><td>System PATH</td"
       & "><td>Required for build, test, and release.</td></tr>"
       & ASCII.LF
       & "<tr><td>gnatprove</td><td>Development</td><td>Alire (dev)</td><td>Required f"
       & "or <code>make prove</code>.</td></tr>"
       & ASCII.LF
       & "<tr><td>gnatdoc</td><td>Development</td><td>Alire (dev)</td><td>Required for"
       & " <code>make doc</code>.</td></tr>"
       & ASCII.LF
       & "<tr><td>gnatformat</td><td>Development</td><td>Alire (dev)</td><td>Required "
       & "for <code>make fmt</code>.</td></tr>"
       & ASCII.LF
       & "<tr><td>Python 3</td><td>Development</td><td>System</td><td>Required for too"
       & "ls/*.py scripts.</td></tr>"
       & ASCII.LF
       & "<tr><td>Playwright</td><td>Development</td><td>npm/pnpm</td><td>Required for"
       & " <code>make e2e</code>.</td></tr>"
       & ASCII.LF
       & "</tbody>"
       & ASCII.LF
       & "</table>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "<h2 id=""good-to-have""><a class=""header"" href=""#good-to-have"">Good to have</a"
       & "></h2>"
       & ASCII.LF
       & "<p>These are optional but improve the workflow.</p>"
       & ASCII.LF
       & "<div class=""table-wrapper"">"
       & ASCII.LF
       & "<table>"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr><th>Dependency</th><th>Category</th><th>Managed by</th><th>Notes</th></t"
       & "r>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr><td>hyperfine</td><td>Good to have</td><td>System</td><td>Improves <code"
       & ">make bench</code> with stable timings.</td></tr>"
       & ASCII.LF
       & "<tr><td>strace</td><td>Good to have</td><td>System</td><td>Required for <cod"
       & "e>make perf-bench</code>.</td></tr>"
       & ASCII.LF
       & "<tr><td>linux-tools-common (<code>perf</code>)</td><td>Good to have</td><td>"
       & "System</td><td>Required for <code>make perf-bench</code>.</td></tr>"
       & ASCII.LF
       & "<tr><td>mandb</td><td>Good to have</td><td>System</td><td>Refreshes the man "
       & "page after <code>adacovex man</code>.</td></tr>"
       & ASCII.LF
       & "</tbody>"
       & ASCII.LF
       & "</table>"
       & ASCII.LF
       & "</div>"

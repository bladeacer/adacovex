       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""technical-name-object"">"
       & ASCII.LF
       & "<h4>Technical Name: Object<a class=""headerlink"" href=""#technical-name-object"
       & """ title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h4>"
       & ASCII.LF
       & "<ul class=""simple"">"
       & ASCII.LF
       & "<li><p><strong>Part of Speech:</strong> Noun</p></li>"
       & ASCII.LF
       & "<li><p><strong>Definition:</strong> A variable or constant that has a type i"

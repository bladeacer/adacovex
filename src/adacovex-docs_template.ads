       & "e</td></tr>"
       & ASCII.LF
       & "<tr><td><code>GET /badge/tests.svg</code></td><td>Test pass/fail badge</td><"
       & "/tr>"
       & ASCII.LF
       & "<tr><td><code>GET /badge/do178c.svg</code></td><td>DO-178C compliance badge "

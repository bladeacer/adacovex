       & ">HLR-DOC</span></code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " C4 <code class=""docutils literal notranslate""><span class=""pre"">--serve</sp"
       & "an></code> semantics and the <code class=""docutils literal notranslate""><spa"
       & "n class=""pre"">--serve-workers</span></code>"
       & ASCII.LF
       & "related-flag documentation in the man page and dashboard docs.</p></li>"
       & ASCII.LF
       & "<li><p><code class=""docutils literal notranslate""><span class=""pre"">HLR-SBOM"
       & "</span></code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " C5 actionable information surfaces reusing the existing JSON"
       & ASCII.LF
       & "API that also feeds the SBOM.</p></li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "<p>See <code class=""docutils literal notranslate""><span class=""pre"">docs/das"
       & "hboard.md</span></code>, <code class=""docutils literal notranslate""><span cl"
       & "ass=""pre"">docs/cli-reference.md</span></code>, and <code class=""docutils lit"
       & "eral notranslate""><span class=""pre"">docs/THIRD_PARTY_NOTICES.md</span></code"
       & ">.</p>"

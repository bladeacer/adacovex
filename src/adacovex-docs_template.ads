       & "(green + red = the category"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s share of the biggest), with the grey track"
       & ASCII.LF
       & "showing the scale remainder "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " so bars scale with magnitude exactly like"
       & ASCII.LF
       & "the test chart.  The numbers mirror gnatprove"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s own summary table: on"
       & ASCII.LF
       & "gnatprove 16 the"
       & ASCII.LF
       & "Flow category sums the "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & "Data Dependencies"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & " and "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & "Flow Dependencies"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & " rows,"
       & ASCII.LF
       & "and every category"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s proved count is Total - Justified - Unproved, so the"

       & ASCII.LF
       & "<li><p><strong>Approved Form:</strong> Aspect (singular), Aspects (plural)</"
       & "p></li>"
       & ASCII.LF
       & "<li><p><strong>Do Not Use:</strong> Property, Annotation, Attribute</p></li>"

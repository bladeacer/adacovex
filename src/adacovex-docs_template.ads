       & ASCII.LF
       & "                        <h1 id=""adacovextypesimplementation""><a class=""heade"
       & "r"" href=""#adacovextypesimplementation"">Adacovex.Types.Implementation</a></h1"
       & ">"
       & ASCII.LF
       & "<p>Non-SPARK container types.  SPARK forbids instantiating the"
       & ASCII.LF
       & "non-formal Ada.Containers in SPARK_Mode On code: gnatprove rejects"
       & ASCII.LF
       & "such instantiations ("
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & "not allowed in SPARK (due to entity declared"
       & ASCII.LF
       & "with SPARK_Mode Off)"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & "; see docs/proof/16.1.0-ledger.md).  This"
       & ASCII.LF
       & "package and Adacovex.Complexity are the only two SPARK_Mode (Off)"
       & ASCII.LF
       & "packages in the codebase, both for the same reason.</p>"
       & ASCII.LF
       & "<blockquote>"
       & ASCII.LF
       & "<p><strong>Note:</strong> All items in this package are public.</p>"
       & ASCII.LF
       & "</blockquote>"
       & ASCII.LF
       & "<h2 id=""types""><a class=""header"" href=""#types"">Types</a></h2>"
       & ASCII.LF
       & "<h3 id=""type-badge_config""><a class=""header"" href=""#type-badge_config"">type "
       & "Badge_Config</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type Badge_Config is record"
       & ASCII.LF
       & "Spark_Lvl   : SPARK_Level := Stone;"
       & ASCII.LF
       & "Test_Summ   : Test_Summary;"
       & ASCII.LF
       & "DAL_Assess  : DAL_Assessment;"
       & ASCII.LF
       & "Show_Spark  : Boolean := True;"
       & ASCII.LF
       & "Show_Tests  : Boolean := True;"
       & ASCII.LF
       & "Show_DO178C : Boolean := True;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-component_info""><a class=""header"" href=""#type-component_info"">t"
       & "ype Component_Info</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type Component_Info is record"
       & ASCII.LF
       & "Ref             : Path_Field;"
       & ASCII.LF
       & "Ref_Len         : Natural := 0;"
       & ASCII.LF
       & "Name            : Desc_Field;"
       & ASCII.LF
       & "Name_Len        : Natural := 0;"
       & ASCII.LF
       & "Version         : Desc_Field;"
       & ASCII.LF
       & "Version_Len     : Natural := 0;"
       & ASCII.LF
       & "License         : Desc_Field;"
       & ASCII.LF
       & "License_Len     : Natural := 0;"
       & ASCII.LF
       & "PURL            : Path_Field;"
       & ASCII.LF
       & "PURL_Len        : Natural := 0;"
       & ASCII.LF
       & "Description     : Path_Field;"
       & ASCII.LF
       & "Description_Len : Natural := 0;"
       & ASCII.LF
       & "Language        : Desc_Field;"
       & ASCII.LF
       & "Language_Len    : Natural := 0;"
       & ASCII.LF
       & "Website         : Path_Field;"
       & ASCII.LF
       & "Website_Len     : Natural := 0;"
       & ASCII.LF
       & "Kind            : Component_Kind := Dependency_Component;"
       & ASCII.LF
       & "Parent          : Natural := 0;"
       & ASCII.LF
       & "From_GPR        : Boolean := False;"
       & ASCII.LF
       & "Scope           : Component_Scope := Scope_Transitive;"
       & ASCII.LF
       & "Scope_Flags     : Dependency_Scope_Flags;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-dal_assessment""><a class=""header"" href=""#type-dal_assessment"">t"
       & "ype DAL_Assessment</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type DAL_Assessment is record"
       & ASCII.LF
       & "Target_DAL             : DAL_Level := DAL_C;"
       & ASCII.LF
       & "Standard               : Compliance_Standard := DO_178C;"
       & ASCII.LF
       & "Status                 : DAL_Status := Unmet;"
       & ASCII.LF
       & "HLR_Total              : Natural := 0;"
       & ASCII.LF
       & "HLR_Found              : Natural := 0;"
       & ASCII.LF
       & "LLR_Total              : Natural := 0;"
       & ASCII.LF
       & "LLR_Found              : Natural := 0;"
       & ASCII.LF
       & "All_Subprograms_Traced : Boolean := False;"
       & ASCII.LF
       & "Orphan_Tags            : Boolean := False;"
       & ASCII.LF
       & "Tests_Passing          : Boolean := False;"
       & ASCII.LF
       & "Min_SPARK_Level_Met    : Boolean := False;"
       & ASCII.LF
       & "Failed_Reasons         : DAL_Failure_Vectors.Vector;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-package_info""><a class=""header"" href=""#type-package_info"">type "
       & "Package_Info</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type Package_Info is record"
       & ASCII.LF
       & "Name        : Name_Field;"
       & ASCII.LF
       & "Name_Len    : Natural := 0;"
       & ASCII.LF
       & "File_Path   : Path_Field;"
       & ASCII.LF
       & "Path_Len    : Natural := 0;"
       & ASCII.LF
       & "Subprograms : Subprogram_Vectors.Vector;"
       & ASCII.LF
       & "HLR_Tags    : HLR_Tag_Vectors.Vector;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-test_summary""><a class=""header"" href=""#type-test_summary"">type "
       & "Test_Summary</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type Test_Summary is record"
       & ASCII.LF
       & "Categories   : Test_Metrics_Vectors.Vector;"
       & ASCII.LF
       & "Total_Passed : Natural := 0;"
       & ASCII.LF
       & "Total_Failed : Natural := 0;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"

                  & ASCII.LF
                  & "        // Set the current, active page, and reveal it if it's hidden"
                  & ASCII.LF
                  & "        let current_page = document.location.href.toString().split('#')[0].s"
                  & "plit('?')[0];"
                  & ASCII.LF
                  & "        if (current_page.endsWith('/')) {"
                  & ASCII.LF
                  & "            current_page += 'index.html';"
                  & ASCII.LF
                  & "        }"
                  & ASCII.LF
                  & "        const links = Array.prototype.slice.call(this.querySelectorAll('a'))"
                  & ";"
                  & ASCII.LF
                  & "        const l = links.length;"
                  & ASCII.LF
                  & "        for (let i = 0; i < l; ++i) {"
                  & ASCII.LF
                  & "            const link = links[i];"
                  & ASCII.LF
                  & "            const href = link.getAttribute('href');"
                  & ASCII.LF
                  & "            if (href && !href.startsWith('#') && !/^(?:[a-z+]+:)?\/\//.test("
                  & "href)) {"
                  & ASCII.LF
                  & "                link.href = path_to_root + href;"
                  & ASCII.LF
                  & "            }"
                  & ASCII.LF
                  & "            // The 'index' page is supposed to alias the first chapter in th"
                  & "e book."
                  & ASCII.LF
                  & "            // Check both with and without the '.html' suffix to be robust a"
                  & "gainst pretty URLs"
                  & ASCII.LF
                  & "            if (link.href.replace(/\.html$/, '') === current_page.replace(/\"
                  & ".html$/, '')"
                  & ASCII.LF
                  & "                || i === 0"
                  & ASCII.LF
                  & "                && path_to_root === ''"
                  & ASCII.LF
                  & "                && current_page.endsWith('/index.html')) {"
                  & ASCII.LF
                  & "                link.classList.add('active');"
                  & ASCII.LF
                  & "                let parent = link.parentElement;"
                  & ASCII.LF
                  & "                while (parent) {"
                  & ASCII.LF
                  & "                    if (parent.tagName === 'LI' && parent.classList.contains"
                  & "('chapter-item')) {"
                  & ASCII.LF
                  & "                        parent.classList.add('expanded');"
                  & ASCII.LF
                  & "                    }"
                  & ASCII.LF
                  & "                    parent = parent.parentElement;"
                  & ASCII.LF
                  & "                }"
                  & ASCII.LF
                  & "            }"
                  & ASCII.LF
                  & "        }"
                  & ASCII.LF
                  & "        // Track and set sidebar scroll position"
                  & ASCII.LF
                  & "        this.addEventListener('click', e => {"
                  & ASCII.LF
                  & "            if (e.target.tagName === 'A') {"
                  & ASCII.LF
                  & "                const clientRect = e.target.getBoundingClientRect();"
                  & ASCII.LF
                  & "                const sidebarRect = this.getBoundingClientRect();"
                  & ASCII.LF
                  & "                sessionStorage.setItem('sidebar-scroll-offset', clientRect.t"
                  & "op - sidebarRect.top);"
                  & ASCII.LF
                  & "            }"
                  & ASCII.LF
                  & "        }, { passive: true });"
                  & ASCII.LF
                  & "        const sidebarScrollOffset = sessionStorage.getItem('sidebar-scroll-o"
                  & "ffset');"
                  & ASCII.LF
                  & "        sessionStorage.removeItem('sidebar-scroll-offset');"
                  & ASCII.LF
                  & "        if (sidebarScrollOffset !== null) {"
                  & ASCII.LF
                  & "            // preserve sidebar scroll position when navigating via links wi"
                  & "thin sidebar"
                  & ASCII.LF
                  & "            const activeSection = this.querySelector('.active');"
                  & ASCII.LF
                  & "            if (activeSection) {"
                  & ASCII.LF
                  & "                const clientRect = activeSection.getBoundingClientRect();"
                  & ASCII.LF
                  & "                const sidebarRect = this.getBoundingClientRect();"
                  & ASCII.LF
                  & "                const currentOffset = clientRect.top - sidebarRect.top;"
                  & ASCII.LF
                  & "                this.scrollTop += currentOffset - parseFloat(sidebarScrollOf"
                  & "fset);"
                  & ASCII.LF
                  & "            }"
                  & ASCII.LF
                  & "        } else {"
                  & ASCII.LF
                  & "            // scroll sidebar to current active section when navigating via"
                  & ASCII.LF
                  & "            // 'next/previous chapter' buttons"

       & ASCII.LF
       & "<section id=""h1-release-workflow-linked-only-the-current-version-s-changelog"
       & """>"
       & ASCII.LF
       & "<h3>H1: release workflow linked only the current version"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s changelog<a class=""headerlink"" href=""#h1-release-workflow-linked-only-the-"
       & "current-version-s-changelog"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<p>The <code class=""docutils literal notranslate""><span class=""pre"">Create</"
       & "span> <span class=""pre"">GitHub</span> <span class=""pre"">Release</span></code"
       & "> step in <code class=""docutils literal notranslate""><span class=""pre"">.gith"

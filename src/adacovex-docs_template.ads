       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""c2-proof-scope-and-justification-policy-docs-reporting"">"
       & ASCII.LF
       & "<h3>C2: Proof scope and justification policy (docs + reporting)<a class=""hea"

       & ASCII.LF
       & "                        <h1 id=""adacovex-cli-reference""><a class=""header"" hr"
       & "ef=""#adacovex-cli-reference"">adacovex CLI Reference</a></h1>"
       & ASCII.LF
       & "<p>This page is the quick reference. It shows usage, the full flag table, an"
       & "d a"
       & ASCII.LF
       & "short note per flag. Feature-specific detail is in dedicated pages (linked"
       & ASCII.LF
       & "from each section):</p>"
       & ASCII.LF
       & "<ul>"
       & ASCII.LF
       & "<li>the <a href=""dashboard.html"">web dashboard</a></li>"
       & ASCII.LF
       & "<li>the <a href=""sbom.html""><code>sbom</code> subcommand</a></li>"
       & ASCII.LF
       & "<li><a href=""vcs.html"">VCS support</a></li>"
       & ASCII.LF
       & "<li>the <a href=""platforms.html#status-subcommand"">platforms/<code>status</c"
       & "ode></a> and"
       & ASCII.LF
       & "<a href=""installation.html"">installation</a> pages</li>"
       & ASCII.LF
       & "<li><a href=""architecture.html"">Architecture</a> for design detail such as r"
       & "esult caching and"
       & ASCII.LF
       & "the patch system</li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "<h2 id=""usage""><a class=""header"" href=""#usage"">Usage</a></h2>"
       & ASCII.LF
       & "<pre><code>adacovex [options]"
       & ASCII.LF
       & "adacovex sbom [--format=cyclonedx-json|spdx-json|md] [--out=PATH]"
       & ASCII.LF
       & "           [--standard=NAME|--dal=LEVEL|--asil=LEVEL|--class=LEVEL]"
       & ASCII.LF
       & "adacovex prove [--target=PATH] [prove options]"
       & ASCII.LF
       & "adacovex status [--target=PATH]"
       & ASCII.LF
       & "adacovex man [--check|--force] [--dir=PATH]"
       & ASCII.LF
       & "adacovex completion [bash|fish|zsh|pwsh]"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h2 id=""flags""><a class=""header"" href=""#flags"">Flags</a></h2>"
       & ASCII.LF
       & "<div class=""table-wrapper"">"
       & ASCII.LF
       & "<table>"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr><th>Flag</th><th>Default</th><th>Mode</th><th>Description</th></tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr><td><code>--target=PATH</code></td><td><code>.</code> (CWD)</td><td>both"
       & "</td><td>Target project root directory</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--manifest=PATH</code></td><td>auto-detected</td><td>both</td>"
       & "<td>Override project manifest path</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--dal=LEVEL</code></td><td><code>C</code></td><td>both</td><td"
       & ">DO-178C DAL level (A-E, also the shared rigour tier)</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--asil=LEVEL</code></td><td>-</td><td>both</td><td>ISO 26262 l"
       & "evel: <code>A</code>|<code>B</code>|<code>C</code>|<code>D</code>|<code>QM</"
       & "code></td></tr>"
       & ASCII.LF
       & "<tr><td><code>--class=LEVEL</code></td><td>-</td><td>both</td><td>IEC 62304 "
       & "safety class: <code>A</code>|<code>B</code>|<code>C</code></td></tr>"
       & ASCII.LF
       & "<tr><td><code>--standard=NAME</code></td><td><code>do178c</code></td><td>bot"
       & "h</td><td><code>do178c</code>|<code>iso26262</code>|<code>iec62304</code>|<c"
       & "ode>all</code></td></tr>"
       & ASCII.LF
       & "<tr><td><code>--serve</code></td><td>off</td><td>both</td><td>Start HTTP das"
       & "hboard server (standard-aware, light/dark/system themes)</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--serve-workers=N</code></td><td><code>4</code></td><td>serve<"
       & "/td><td>HTTP server task-pool worker count</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--theme=NAME</code></td><td><code>system</code></td><td>serve<"
       & "/td><td>Dashboard theme: <code>light</code>|<code>dark</code>|<code>system</"
       & "code></td></tr>"
       & ASCII.LF
       & "<tr><td><code>--port=N</code></td><td><code>8080</code></td><td>serve</td><t"
       & "d>Dashboard server port</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--tz=ZONE</code> / <code>--timezone=ZONE</code></td><td>OS tim"
       & "ezone</td><td>both</td><td>Display timezone (IANA name or UTC/GMT offset)</t"
       & "d></tr>"
       & ASCII.LF
       & "<tr><td><code>--excludes=EXT,EXT</code></td><td>empty</td><td>complexity</td"
       & "><td>Skip comma-separated file extensions</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--emit-svg=PATH</code></td><td><code>&lt;target&gt;/docs/badge"
       & "s</code></td><td>both</td><td>Output directory for SVG badges</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--no-svg</code></td><td>off</td><td>both</td><td>Suppress SVG "
       & "badge output</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--emit-markdown=PATH</code></td><td>off</td><td>both</td><td>O"
       & "utput directory for Markdown reports</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--emit-metrics=PATH</code></td><td>off</td><td>both</td><td>Wr"
       & "ite a JSON export of metrics + dependency graph to PATH</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--completion[=SHELL]</code></td><td>-</td><td>-</td><td>Print "
       & "shell completion script (bash/fish/zsh/pwsh, auto-detected) and exit</td></t"
       & "r>"
       & ASCII.LF
       & "<tr><td><code>--skip-dir=NAME</code></td><td><code>demo,deps,examples</code>"
       & "</td><td>relaxed</td><td>Directory name to skip (repeatable)</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--relaxed</code></td><td>off</td><td>both</td><td>Disable stri"
       & "ct mode (skip dirs, no patches)</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--compare-base=REF</code></td><td>off</td><td>both</td><td>Dif"
       & "ferential mode vs a base rev (git/hg/svn/fossil/jj)</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--coverage-delta=REF</code></td><td>off</td><td>both</td><td>D"
       & "ocstring-coverage gate vs a base rev (git/hg/svn/fossil/jj)</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--cache</code></td><td>on</td><td>both</td><td>Enable on-disk "
       & "result caching</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--no-cache</code></td><td>off</td><td>both</td><td>Disable res"
       & "ult caching (always re-scan/re-parse/re-prove)</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--cache-dir=PATH</code></td><td><code>~/.adacovex/cache/&lt;ve"
       & "r&gt;/&lt;schema&gt;</code></td><td>both</td><td>Cache directory for analysi"
       & "s results</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--cache-max=N</code></td><td><code>4096</code></td><td>both</t"
       & "d><td>Max cache entries before oldest-first eviction</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--no-sbom</code></td><td>off</td><td>both</td><td>Skip the aut"
       & "omatic SBOM written at the end of every assessment</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--sbom-format=FMT</code></td><td><code>cyclonedx-json</code></"
       & "td><td>both</td><td>Format of the automatic SBOM: <code>cyclonedx-json</code"
       & ">|<code>spdx-json</code>|<code>md</code></td></tr>"
       & ASCII.LF
       & "<tr><td><code>--require-spark=LVL</code></td><td>off</td><td>both</td><td>Fa"
       & "il loudly (exit 1) if SPARK level &lt; LVL (Stone..Platinum)</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--require-docstrings=PCT</code></td><td>off</td><td>both</td><"
       & "td>Fail loudly if docstring coverage &lt; PCT% (0-100)</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--require-tests=N</code></td><td>off</td><td>both</td><td>Fail"
       & " loudly if passing test count &lt; N</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--require-proof=PCT</code></td><td>off</td><td>both</td><td>Fa"
       & "il loudly if proved-VC coverage &lt; PCT% (0-100)</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--verbose</code></td><td>off</td><td>both</td><td>Verbose diag"
       & "nostics</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--version</code></td><td>-</td><td>-</td><td>Print the bundled"
       & " version and exit</td></tr>"
       & ASCII.LF
       & "<tr><td><code>man</code></td><td>-</td><td>-</td><td>Install the man page in"
       & "to the local man database</td></tr>"
       & ASCII.LF
       & "<tr><td><code>man --check</code></td><td>-</td><td>-</td><td>Exit 0 if the i"
       & "nstalled man page matches the binary version, 1 otherwise</td></tr>"
       & ASCII.LF
       & "<tr><td><code>man --force</code></td><td>-</td><td>-</td><td>Reinstall the m"
       & "an page even when it already matches (repair)</td></tr>"
       & ASCII.LF
       & "<tr><td><code>man --dir=PATH</code></td><td><code>~/.local/share/man</code><"
       & "/td><td>-</td><td>Install the man page under <code>PATH/man1</code> instead<"
       & "/td></tr>"
       & ASCII.LF
       & "<tr><td><code>--help</code></td><td>-</td><td>both</td><td>Print usage and e"
       & "xit</td></tr>"
       & ASCII.LF
       & "</tbody>"
       & ASCII.LF
       & "</table>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "<p><code>prove</code>-mode flags are also accepted by the main command. They"
       & " are validated"
       & ASCII.LF
       & "only in prove mode. The flags are: <code>--jobs</code>/<code>-j</code>, <cod"
       & "e>--level</code>, <code>--timeout</code>,"
       & ASCII.LF
       & "<code>--steps</code>, <code>--memlimit</code>, <code>--force</code>, <code>-"
       & "-no-loop-unrolling</code>, <code>--no-inlining</code>,"
       & ASCII.LF
       & "<code>--suppress-warnings</code>, <code>--quiet</code>. See"
       & ASCII.LF
       & "<a href=""#the-prove-subcommand"">The <code>prove</code> subcommand</a>.</p>"
       & ASCII.LF
       & "<h2 id=""flag-details""><a class=""header"" href=""#flag-details"">Flag details</a"
       & "></h2>"
       & ASCII.LF
       & "<h3 id=""--targetpath""><a class=""header"" href=""#--targetpath""><code>--target="
       & "PATH</code></a></h3>"
       & ASCII.LF
       & "<p>Project to analyse. Relative paths are resolved against the current worki"
       & "ng"
       & ASCII.LF
       & "directory to an absolute path. The path determines the root directory for"
       & ASCII.LF
       & "source scanning, manifest detection, SVG badge output, and patch file"
       & ASCII.LF
       & "resolution. Default: the current working directory.</p>"
       & ASCII.LF
       & "<h3 id=""--manifestpath""><a class=""header"" href=""#--manifestpath""><code>--man"
       & "ifest=PATH</code></a></h3>"
       & ASCII.LF
       & "<p>Override the project manifest file. Auto-detected from"
       & ASCII.LF
       & "<code>&lt;target&gt;/alire-dev.toml</code> or <code>&lt;target&gt;/alire.tom"
       & "l</code> (dev first). The manifest"
       & ASCII.LF
       & "path is shown in stderr output and used by <code>adacovex sbom</code> to res"
       & "olve the root"
       & ASCII.LF
       & "project metadata for the dependency graph.</p>"
       & ASCII.LF
       & "<h3 id=""--dallevel""><a class=""header"" href=""#--dallevel""><code>--dal=LEVEL</"
       & "code></a></h3>"
       & ASCII.LF
       & "<p>DO-178C DAL level (and the shared rigour tier): <code>A</code>, <code>B</"
       & "code>, <code>C</code>, <code>D</code>, or <code>E</code>"
       & ASCII.LF
       & "(case-insensitive). It determines the minimum SPARK proof level required and"
       & ASCII.LF
       & "the specific criteria checked. This tier is shared across standards."
       & ASCII.LF
       & "<code>--dal=C</code> is DAL-C under DO-178C, ASIL B under ISO 26262, and saf"
       & "ety Class A"
       & ASCII.LF
       & "under IEC 62304. See <a href=""api-docs/adacovex-dal-levels.html"">DAL levels<"
       & "/a> and"
       & ASCII.LF
       & "<a href=""standards.html"">Standards</a>.</p>"
       & ASCII.LF
       & "<h3 id=""--asillevel""><a class=""header"" href=""#--asillevel""><code>--asil=LEVE"
       & "L</code></a></h3>"
       & ASCII.LF
       & "<p>ISO 26262 Automotive Safety Integrity Level: <code>A</code>, <code>B</cod"
       & "e>, <code>C</code>, <code>D</code>, or <code>QM</code>"
       & ASCII.LF
       & "(case-insensitive). It sets the standard to <code>iso26262</code> and maps t"
       & "he ASIL level"
       & ASCII.LF
       & "to the shared rigour tier (ASIL D -&gt; DAL A, ASIL C -&gt; DAL B, ASIL B -&"
       & "gt; DAL C,"
       & ASCII.LF
       & "ASIL A -&gt; DAL D, QM -&gt; DAL E). As a result, <code>--asil=B</code> is t"
       & "he clearest spelling"
       & ASCII.LF
       & "of "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & "assess this project at ASIL B"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & ". See"
       & ASCII.LF
       & "<a href=""api-docs/adacovex-asil-levels.html"">ASIL Levels</a>.</p>"
       & ASCII.LF
       & "<h3 id=""--classlevel""><a class=""header"" href=""#--classlevel""><code>--class=L"
       & "EVEL</code></a></h3>"
       & ASCII.LF
       & "<p>IEC 62304 software safety class: <code>A</code>, <code>B</code>, or <code"
       & ">C</code> (case-insensitive). It sets"
       & ASCII.LF
       & "the standard to <code>iec62304</code> and maps the class to the shared rigou"
       & "r tier"
       & ASCII.LF
       & "(Class C -&gt; DAL A, Class B -&gt; DAL B, Class A -&gt; DAL C). As a result"
       & ","
       & ASCII.LF
       & "<code>--class=A</code> is the clearest spelling of "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & "assess this project at safety Class"
       & ASCII.LF
       & "A"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & ". See <a href=""api-docs/adacovex-class-levels.html"">Safety Classes</a>.</p>"
       & ASCII.LF
       & "<h3 id=""--standardname""><a class=""header"" href=""#--standardname""><code>--sta"
       & "ndard=NAME</code></a></h3>"
       & ASCII.LF
       & "<p>Select the compliance standard used to label the assessment (default"
       & ASCII.LF
       & "<code>do178c</code>). The evidence checks are identical across standards. On"
       & "ly the"
       & ASCII.LF
       & "integrity-level names change in the report and badges:</p>"
       & ASCII.LF
       & "<ul>"
       & ASCII.LF
       & "<li><code>do178c</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " DAL A"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "E (avionics)</li>"
       & ASCII.LF
       & "<li><code>iso26262</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " ASIL D / C / B / A / QM (automotive)</li>"
       & ASCII.LF
       & "<li><code>iec62304</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " Class C / B / A / no class (medical-device software)</li>"
       & ASCII.LF
       & "<li><code>all</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " run one assessment at the shared tier and emit badges/reports for"
       & ASCII.LF
       & "every standard (<code>do178c.svg</code>, <code>iso26262.svg</code>, <code>ie"
       & "c62304.svg</code>)</li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "<p>Accepted case-insensitively, with or without the hyphen/space (<code>ISO-"
       & "26262</code>,"
       & ASCII.LF
       & "<code>iec62304</code>, and more). See <a href=""standards.html"">Standards</a>"
       & " for the full tier"
       & ASCII.LF
       & "mapping.</p>"
       & ASCII.LF
       & "<p>When both a dedicated level flag (<code>--asil</code> / <code>--class</co"
       & "de>) and <code>--standard</code> are"
       & ASCII.LF
       & "passed, the dedicated flag sets the standard. <code>--standard</code> is ign"
       & "ored for"
       & ASCII.LF
       & "labelling (last-write-wins per field). The shared tier is always whatever th"
       & "e"
       & ASCII.LF
       & "level flag (or <code>--dal</code>) resolved to.</p>"
       & ASCII.LF
       & "<h3 id=""status""><a class=""header"" href=""#status""><code>status</code></a></h3"
       & ">"
       & ASCII.LF
       & "<p><code>adacovex status [--target=PATH]</code> reports toolchain and platfo"
       & "rm state. It"
       & ASCII.LF
       & "does not run an assessment. It does not download or deploy anything. It"
       & ASCII.LF
       & "reports the following:</p>"
       & ASCII.LF
       & "<ul>"
       & ASCII.LF
       & "<li>whether Alire is installed</li>"
       & ASCII.LF
       & "<li>how gnatprove is resolved</li>"
       & ASCII.LF
       & "<li>the host CPU count and CI status (and the resulting default <code>-j</co"
       & "de>"
       & ASCII.LF
       & "parallelism)</li>"
       & ASCII.LF
       & "<li>a <strong>VCS report</strong> (which VCS tools are on <code>$PATH</code>"
       & " and which manages the"
       & ASCII.LF
       & "target "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " see <a href=""vcs.html"">VCS support</a>)</li>"
       & ASCII.LF
       & "<li>mandb availability</li>"
       & ASCII.LF
       & "<li>the effective display timezone, the current date/time in it, and how man"
       & "y"
       & ASCII.LF
       & "dated release changelogs the target carries</li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "<p><code>adacovex status --tz=ZONE</code> (or <code>--timezone=ZONE</code>) "
       & "overrides the display"
       & ASCII.LF
       & "timezone for the report. It shows the effective timezone, the current date"
       & ASCII.LF
       & "and time in that zone, and how many dated release changelogs the target"
       & ASCII.LF
       & "carries. Exit <code>0</code> when a usable gnatprove is detectable without a"
       & " download."
       & ASCII.LF
       & "Exit <code>1</code> otherwise; for full detail see"
       & ASCII.LF
       & "<a href=""platforms.html#status-subcommand"">Platforms "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " <code>status</code> subcommand</a>.</p>"
       & ASCII.LF
       & "<p><code>adacovex status --export</code> prints the report as machine-readab"
       & "le JSON on"
       & ASCII.LF
       & "stdout; <code>status --export=PATH</code> writes it to <code>PATH</code>. Sc"
       & "ripts and CI can"
       & ASCII.LF
       & "consume it without parsing prose. <code>adacovex status --metrics</code> pri"
       & "nts the"
       & ASCII.LF
       & "same data as compact <code>key=value</code> lines, one per line, for shell s"
       & "cripts."
       & ASCII.LF
       & "Both flags only work with the <code>status</code> subcommand.</p>"
       & ASCII.LF
       & "<h3 id=""complexity""><a class=""header"" href=""#complexity""><code>complexity</c"
       & "ode></a></h3>"
       & ASCII.LF
       & "<p><code>adacovex complexity [--target=PATH] [--excludes=EXT,EXT]</code> run"
       & "s a"
       & ASCII.LF
       & "cyclomatic-complexity and LOC check across the target"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s source files in many"
       & ASCII.LF
       & "languages. <code>--excludes=EXT,EXT</code> skips comma-separated file extens"
       & "ions (for"
       & ASCII.LF
       & "example <code>md,rst</code>) and only works with the <code>complexity</code>"
       & " subcommand. It prints"
       & ASCII.LF
       & "a tokei-style summary (files, lines, code, comments, blanks) plus a per-file"
       & ASCII.LF
       & "table of <code>Lines=</code>, <code>Code=</code>, <code>Comments=</code>, <c"
       & "ode>Blanks=</code>, the codebase loc"
       & ASCII.LF
       & "percentage, and the cyclomatic complexity <code>cx=</code>. The gate fails w"
       & "hen a file"
       & ASCII.LF
       & "or function exceeds the thresholds (defaults: 4 000 LOC, 10% of codebase per"
       & ASCII.LF
       & "file, 120 per function, 600 per file).</p>"
       & ASCII.LF
       & "<p>Exit <code>0</code> when all gates pass. Exit <code>1</code> otherwise. T"
       & "his replaces the"
       & ASCII.LF
       & "previous Python <code>check-complexity.py</code> script and is wired into"
       & ASCII.LF
       & "<code>make complexity-check</code>.</p>"
       & ASCII.LF
       & "<h3 id=""the-prove-subcommand""><a class=""header"" href=""#the-prove-subcommand"""
       & ">The <code>prove</code> subcommand</a></h3>"
       & ASCII.LF
       & "<p><code>adacovex prove --target=PATH</code> resolves a gnatprove installati"
       & "on and runs it against the target. It then falls through to the normal asses"
       & "sment pipeline. The pipeline parses the freshly generated proof summary. As "
       & "a result, one command both proves and assesses.</p>"
       & ASCII.LF
       & "<p>For the full guide to proving and writing SPARK proofs (contracts, VC cat"
       & "egories, proof patches for vendored deps), see <a href=""proving.html"">Provin"
       & "g and writing proofs</a>. gnatprove is resolved in this order: manifest pin "
       & "&gt; global pin &gt; <code>$PATH</code> &gt; cached toolchain &gt; download."
       & " The target does not need to declare gnatprove. Full detail: <a href=""archit"
       & "ecture.html#gnatprove-toolchain-resolution-prove-subcommand"">Architecture "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " GNATprove toolchain resolution</a>.</p>"
       & ASCII.LF
       & "<p>The proof summary is written to <code>&lt;target&gt;/obj/gnatprove/gnatpr"
       & "ove.out</code> (the same location the assessment discovers). The SVG badges "
       & "are emitted as usual. The result cache serves unchanged targets. <code>--for"
       & "ce</code> bypasses the cache and forces a full gnatprove reanalysis. When th"
       & "e target carries proof patches (<code>.adacovex/patches/</code>), gnatprove "
       & "runs against a patched tree copy at <code>&lt;target&gt;/obj/adacovex-proof/"
       & "</code>.</p>"
       & ASCII.LF
       & "<p>Vendored dependencies then participate in the proof without their sources"
       & " being touched. See <a href=""proving.html#proof-patches-proving-vendored-dep"
       & "endencies"">Proving and writing proofs</a> for how to write them, and <a href"
       & "=""architecture.html#proof-patches-spark-contracts-over-vendored-dependencies"
       & """>Architecture "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " Proof patches</a> for the design.</p>"
       & ASCII.LF
       & "<div class=""table-wrapper"">"
       & ASCII.LF
       & "<table>"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr><th>Flag</th><th>Default</th><th>Description</th></tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr><td><code>--jobs=N</code>, <code>-j N</code></td><td>auto</td><td>GNATpr"
       & "ove parallelism: auto-detect (max(1, cores-2), all cores in CI), <code>0</co"
       & "de> = all cores, <code>N</code> = pin N processes</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--level=N</code></td><td>tool default</td><td>GNATprove proof "
       & "effort, 0-4</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--timeout=N</code></td><td>tool default</td><td>Per-check prov"
       & "er timeout in seconds</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--steps=N</code></td><td><code>10000</code></td><td>Max proof "
       & "steps (reproducible budget, an explicit value overrides the default)</td></t"
       & "r>"
       & ASCII.LF
       & "<tr><td><code>--memlimit=N</code></td><td>tool default</td><td>Prover memory"
       & " limit in MB</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--force</code></td><td>off</td><td>Force full gnatprove reanal"
       & "ysis (<code>-f</code>). Also bypasses the result cache</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--no-loop-unrolling</code></td><td>always on</td><td>Disable a"
       & "utomatic loop unrolling. Loop unrolling is always disabled, so GNATprove nev"
       & "er emits the purely-informational <code>cannot unroll loop (too many loop it"
       & "erations) [info-unrolling-inlining]</code> notice. It is proof-neutral for t"
       & "he dogfood targets (720/720 adacovex, 589/589 Ada_CRDT VCs, 0 unproved). Fla"
       & "g kept for compatibility</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--no-inlining</code></td><td>off</td><td>Disable contextual an"
       & "alysis inlining</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--quiet</code></td><td>on</td><td>Hide GNATprove"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s benign info messages (the default suppression set, the loop-unrolling/inli"
       & "ning notice blocks) from stdout. It is active by default for local runs. <co"
       & "de>--verbose</code> always shows every message and wins over it. CI passes <"
       & "code>--verbose</code>, so CI output stays authoritative. This is the explici"
       & "t form of the default</td></tr>"
       & ASCII.LF
       & "<tr><td><code>--suppress-warnings</code></td><td>on</td><td>Alias of <code>-"
       & "-quiet</code> (the default suppression set). Kept for compatibility</td></tr"
       & ">"
       & ASCII.LF
       & "<tr><td><code>--suppress-warnings=SETS</code></td><td>on</td><td>Hide GNATpr"
       & "ove info messages whose tags match the comma-separated suppression-set names"
       & " (for example <code>--suppress-warnings=unrolling-inlining,xyz</code>). A se"
       & "t name <code>S</code> suppresses blocks tagged <code>[info-S]</code> (or bar"
       & "e <code>[S]</code>). <code>--verbose</code> always shows every message</td><"
       & "/tr>"
       & ASCII.LF
       & "</tbody>"
       & ASCII.LF
       & "</table>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "<p><code>prove</code> accepts all assessment flags too (<code>--dal</code>, "
       & "<code>--standard</code>, the"
       & ASCII.LF
       & "<code>--require-*</code> gates, <code>--emit-svg</code>, and more), so CI ga"
       & "tes apply to the proof"
       & ASCII.LF
       & "run directly. <code>--force</code> is shared with <code>man --force</code> ("
       & "see below). The"
       & ASCII.LF
       & "remaining prove flags are validated only in prove mode.</p>"
       & ASCII.LF
       & "<h3 id=""automatic-sbom---no-sbom----sbom-format""><a class=""header"" href=""#au"
       & "tomatic-sbom---no-sbom----sbom-format"">Automatic SBOM (<code>--no-sbom</code"
       & "> / <code>--sbom-format</code>)</a></h3>"
       & ASCII.LF
       & "<p>Every assessment writes a proof-aware SBOM by default (the pipeline"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s last"
       & ASCII.LF
       & "step): <code>&lt;target&gt;/sbom.json</code> (CycloneDX 1.5), <code>&lt;targ"
       & "et&gt;/sbom.spdx.json</code>"
       & ASCII.LF
       & "(SPDX 2.3), or <code>&lt;target&gt;/docs/compliance/SBOM.md</code> depending"
       & " on"
       & ASCII.LF
       & "<code>--sbom-format</code> (default <code>cyclonedx-json</code>). <code>--no"
       & "-sbom</code> skips it entirely."
       & ASCII.LF
       & "These are separate from the dedicated <a href=""sbom.html""><code>sbom</code> "
       & "subcommand</a>, which"
       & ASCII.LF
       & "writes a single SBOM at an explicit path and exits.</p>"
       & ASCII.LF
       & "<h3 id=""--serve""><a class=""header"" href=""#--serve""><code>--serve</code></a><"
       & "/h3>"
       & ASCII.LF
       & "<p>A <strong>switch</strong>: when given, adacovex scans and assesses the ta"
       & "rget, then starts the built-in HTTP/1.1 web dashboard on <code>--port</code>"
       & " (default <code>8080</code>) and blocks until interrupted. Passing <code>--s"
       & "erve</code> is the only way to start the server; omitting it (the default, <"
       & "code>off</code>) renders and exits without serving. There is no <code>--no-s"
       & "erve</code>, because the flag already controls it. It serves an HTML dashboa"
       & "rd at <code>/</code>, a JSON API at <code>/api/metrics</code>, the SVG badge"
       & "s at <code>/badge/*.svg</code>, and the bundled offline manual at <code>/doc"
       & "s</code>.</p>"
       & ASCII.LF
       & "<p>The dashboard is standard-aware (it defaults to all standards) and suppor"
       & "ts light, dark, and system themes.</p>"
       & ASCII.LF
       & "<p>Full detail, the JSON schema, the theme-resolution order, and embedding t"
       & "ips are in <a href=""dashboard.html"">Web dashboard and JSON API</a>. Related "
       & "flags: <code>--port</code>, <code>--serve-workers</code>, <code>--theme</cod"
       & "e>.</p>"
       & ASCII.LF
       & "<h3 id=""--themename""><a class=""header"" href=""#--themename""><code>--theme=NAM"
       & "E</code></a></h3>"
       & ASCII.LF
       & "<p>Dashboard colour theme for <code>--serve</code>: <code>system</code> (def"
       & "ault, follows <code>prefers-color-scheme</code>), <code>light</code>, or <co"
       & "de>dark</code> (case-insensitive). It sets the initial dropdown selection in"
       & " the served page. The header dropdown can switch live afterwards, and <stron"
       & "g>Save settings</strong> persists the choice in <code>localStorage</code> (n"
       & "o cookies). Only relevant with <code>--serve</code>.</p>"
       & ASCII.LF
       & "<p>See <a href=""dashboard.html#themes"">dashboard themes</a>.</p>"
       & ASCII.LF
       & "<h3 id=""--portn""><a class=""header"" href=""#--portn""><code>--port=N</code></a>"
       & "</h3>"
       & ASCII.LF
       & "<p>HTTP server port when <code>--serve</code> is used. Must be a valid <code"
       & ">Positive</code> integer."
       & ASCII.LF
       & "Only relevant with <code>--serve</code>.</p>"
       & ASCII.LF
       & "<h3 id=""--serve-workersn""><a class=""header"" href=""#--serve-workersn""><code>-"
       & "-serve-workers=N</code></a></h3>"
       & ASCII.LF
       & "<p>HTTP server task-pool worker count when <code>--serve</code> is used. Def"
       & "ault is <code>4</code>."
       & ASCII.LF
       & "Raise it to handle more concurrent dashboard requests, or lower it to use"
       & ASCII.LF
       & "less memory. It must be a valid <code>Positive</code> integer and only works"
       & " with"
       & ASCII.LF
       & "<code>--serve</code>.</p>"
       & ASCII.LF
       & "<h3 id=""--tzzone----timezonezone""><a class=""header"" href=""#--tzzone----timez"
       & "onezone""><code>--tz=ZONE</code> / <code>--timezone=ZONE</code></a></h3>"
       & ASCII.LF
       & "<p>Display timezone for the status report.  Accepts a well-known IANA name"
       & ASCII.LF
       & "(for example <code>Asia/Singapore</code>) or a fixed UTC/GMT offset (<code>U"
       & "TC+8</code>, <code>GMT+8</code>,"
       & ASCII.LF
       & "<code>UTC+08</code>, <code>GMT+08</code>, <code>UTC+08:30</code>).  Without "
       & "it adacovex uses the operating"
       & ASCII.LF
       & "system"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s timezone.</p>"
       & ASCII.LF
       & "<p>A named zone resolves from a built-in table of common IANA names.  A zone"
       & ASCII.LF
       & "that may observe daylight saving time, or one the table lacks, is probed"
       & ASCII.LF
       & "against the platform tzdata (<code>zdump</code> + <code>date +%z</code>) for"
       & " the DST-correct"
       & ASCII.LF
       & "current offset, with the table as the fallback when the probe is"
       & ASCII.LF
       & "unavailable.  Values are matched case-insensitively, and a bad value fails"
       & ASCII.LF
       & "loudly.</p>"
       & ASCII.LF
       & "<h3 id=""--emit-svgpath""><a class=""header"" href=""#--emit-svgpath""><code>--emi"
       & "t-svg=PATH</code></a></h3>"
       & ASCII.LF
       & "<p>Write SVG badges to a directory. Default <code>&lt;target&gt;/docs/badges"
       & "</code>"
       & ASCII.LF
       & "(project-scoped). Creates:</p>"
       & ASCII.LF
       & "<ul>"
       & ASCII.LF
       & "<li><code>spark.svg</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " SPARK assurance level (Stone through Platinum)</li>"
       & ASCII.LF
       & "<li><code>tests.svg</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " test pass/fail count</li>"
       & ASCII.LF
       & "<li><code>do178c.svg</code> / <code>iso26262.svg</code> / <code>iec62304.svg"
       & "</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " compliance status for the"
       & ASCII.LF
       & "selected standard (Achieved / Unmet), or all three with <code>--standard=all"
       & "</code></li>"
       & ASCII.LF
       & "<li><code>docs.svg</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " docstring coverage percentage</li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "<p><code>--no-svg</code> overrides and disables SVG output entirely.</p>"
       & ASCII.LF
       & "<h3 id=""--no-svg""><a class=""header"" href=""#--no-svg""><code>--no-svg</code></"
       & "a></h3>"
       & ASCII.LF
       & "<p>Suppress all SVG badge output. Overrides <code>--emit-svg</code> if both "
       & "are given.</p>"
       & ASCII.LF
       & "<h3 id=""--emit-metricspath""><a class=""header"" href=""#--emit-metricspath""><co"
       & "de>--emit-metrics=PATH</code></a></h3>"
       & ASCII.LF
       & "<p>After the assessment, it writes a machine-readable JSON export to <code>P"
       & "ATH</code>:"
       & ASCII.LF
       & "<code>{""metrics"": {...}, ""dependencies"": {...}}</code>.  <code>metrics</code"
       & "> is the same"
       & ASCII.LF
       & "object the dashboard JSON API serves at <code>/api/metrics</code>.  <code>de"
       & "pendencies</code> is"
       & ASCII.LF
       & "the resolved dependency graph (name, version, scope, parent, purl, kind) at"
       & ASCII.LF
       & "<code>/api/deps</code>.  It is useful for scripting gates, external dashboar"
       & "ds, or"
       & ASCII.LF
       & "archiving assessment results. The composite GitHub Action uploads it as a CI"
       & ASCII.LF
       & "artifact when <code>emit-metrics</code> is set.</p>"
       & ASCII.LF
       & "<h3 id=""--emit-markdownpath""><a class=""header"" href=""#--emit-markdownpath""><"
       & "code>--emit-markdown=PATH</code></a></h3>"
       & ASCII.LF
       & "<p>Write compliance reports to a directory. Creates two files:</p>"
       & ASCII.LF
       & "<ul>"
       & ASCII.LF
       & "<li><code>VERIFICATION.md</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " full verification report with all metrics</li>"
       & ASCII.LF
       & "<li><code>TRACE.md</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " HLR traceability matrix (source-to-requirement mapping)</li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "<h3 id=""--skip-dirname""><a class=""header"" href=""#--skip-dirname""><code>--ski"
       & "p-dir=NAME</code></a></h3>"
       & ASCII.LF
       & "<p>Add a directory name to the scanner"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s skip list (repeatable). Directories whose"
       & ASCII.LF
       & "simple name matches an entry are not recursed into during source scanning."
       & ASCII.LF
       & "Only effective in relaxed mode. In strict mode (default) the skip list is"
       & ASCII.LF
       & "always empty.</p>"
       & ASCII.LF
       & "<h3 id=""--relaxed""><a class=""header"" href=""#--relaxed""><code>--relaxed</code"
       & "></a></h3>"
       & ASCII.LF
       & "<p>Disable strict mode. Enables the skip list (default <code>demo,deps,examp"
       & "les</code> plus"
       & ASCII.LF
       & "any <code>--skip-dir</code> entries) and does NOT apply <code>.adacovex/patc"
       & "hes/</code>. See"
       & ASCII.LF
       & "<a href=""#strict-vs-relaxed-mode"">Strict vs relaxed mode</a>.</p>"
       & ASCII.LF
       & "<h3 id=""--compare-baseref""><a class=""header"" href=""#--compare-baseref""><code"
       & ">--compare-base=REF</code></a></h3>"
       & ASCII.LF
       & "<p>Differential mode: snapshot a base revision and print a side-by-side comp"
       & "arison against the current tree (packages, subprograms, docstring %, HLR tra"
       & "ced, orphan tags, SPARK level, VCs proved, tests, DAL status). Exit <code>0<"
       & "/code> only if there are no regressions AND the current DAL is Achieved. Exi"
       & "t <code>1</code> otherwise. Works on <strong>git, Mercurial, Subversion, Fos"
       & "sil, and jj</strong>.</p>"
       & ASCII.LF
       & "<p>Full detail and the per-VCS snapshot mechanisms are in <a href=""vcs.html"""
       & ">VCS support and differential assessment</a>.</p>"
       & ASCII.LF
       & "<h3 id=""--coverage-deltaref""><a class=""header"" href=""#--coverage-deltaref""><"
       & "code>--coverage-delta=REF</code></a></h3>"
       & ASCII.LF
       & "<p>Lightweight docstring-coverage gate for PR-style CI checks. Scans sources"
       & " + patches + computes docstring metrics on both a base revision and the curr"
       & "ent tree (no GNATprove/tests/DAL), prints a compact coverage table plus a ma"
       & "chine-parseable <code>coverage_delta:</code> line, and cleans up the snapsho"
       & "t. Exit <code>0</code> if current docstring coverage is <code>&gt;=</code> t"
       & "he base. Exit <code>1</code> if coverage regressed.</p>"
       & ASCII.LF
       & "<p>Mutually exclusive with <code>--compare-base</code>. See <a href=""vcs.htm"
       & "l"">VCS support and differential assessment</a>.</p>"
       & ASCII.LF
       & "<h3 id=""--version""><a class=""header"" href=""#--version""><code>--version</code"
       & "></a></h3>"
       & ASCII.LF
       & "<p>Print the bundled version (<code>adacovex vX. Y. Z</code>) and exit, with"
       & "out scanning or assessing. The version source depends on the <strong>install"
       & "ation method</strong> (<code>ADACOVEX_VERSION</code> for release builds, <co"
       & "de>alire-dev.toml</code> for source checkouts, <code>alire.toml</code> for d"
       & "ependency-managed installs).</p>"
       & ASCII.LF
       & "<p>The same constant drives the man page, the SBOM tool version, and the res"
       & "ult-cache namespace. As a result, they cannot drift. Full detail: <a href=""i"
       & "nstallation.html#version-source-per-installation-method"">Installation "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " version source</a>.</p>"
       & ASCII.LF
       & "<h3 id=""completion""><a class=""header"" href=""#completion""><code>completion</c"
       & "ode></a></h3>"
       & ASCII.LF
       & "<p><code>adacovex completion [SHELL]</code> (also <code>adacovex --completio"
       & "n[=SHELL]</code>) prints"
       & ASCII.LF
       & "a static shell-completion script to stdout and exits.  <code>SHELL</code> is"
       & " one of"
       & ASCII.LF
       & "<code>bash</code>, <code>fish</code>, <code>zsh</code>, <code>pwsh</code>, w"
       & "hen omitted it is auto-detected from"
       & ASCII.LF
       & "<code>$SHELL</code>, falling back to bash for unknown or empty shells.  Typi"
       & "cal setup:</p>"
       & ASCII.LF
       & "<pre><code class=""language-bash"">eval ""$(adacovex completion)""        # bash"
       & " (default)"
       & ASCII.LF
       & "source &lt;(adacovex completion zsh)    # zsh"
       & ASCII.LF
       & "adacovex completion fish | source    # fish"
       & ASCII.LF
       & "adacovex completion pwsh | Invoke-Expression   # PowerShell"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<p>The scripts complete the subcommands and every long flag from the binary"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s"
       & ASCII.LF
       & "own flag table, so the completion set cannot drift from the CLI. The flag"
       & ASCII.LF
       & "list embeds at generation time. Re-run <code>adacovex completion</code> afte"
       & "r upgrading"
       & ASCII.LF
       & "adacovex (a shell prompt hook that regenerates on version change works well)"
       & ".</p>"
       & ASCII.LF
       & "<h3 id=""man""><a class=""header"" href=""#man""><code>man</code></a></h3>"
       & ASCII.LF
       & "<p>The <code>man</code> subcommand installs the adacovex man page into the <"
       & "strong>local man"
       & ASCII.LF
       & "database</strong> (Linux/WSL, no root required) and refreshes the index with"
       & " <code>mandb</code>"
       & ASCII.LF
       & "when present. <code>adacovex man --check</code> exits 0 when the installed p"
       & "age matches"
       & ASCII.LF
       & "the binary. It exits 1 otherwise (a shell prompt hook can auto-update as a"
       & ASCII.LF
       & "result). <code>--dir=PATH</code> overrides the install root. Full detail, ex"
       & "it codes,"
       & ASCII.LF
       & "and the prompt-hook recipe are in"
       & ASCII.LF
       & "<a href=""installation.html#keeping-the-man-page-in-sync"">Installation "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " keeping the man page in sync</a>.</p>"
       & ASCII.LF
       & "<h3 id=""vcs-support""><a class=""header"" href=""#vcs-support"">VCS support</a></"
       & "h3>"
       & ASCII.LF
       & "<p><strong>A version control system is not required for base adacovex functi"
       & "onality</strong>"
       & ASCII.LF
       & "(scanning, proof analysis, test parsing, compliance assessment, SBOM generat"
       & "ion, dashboards, caching). A VCS is only needed for the differential modes ("
       & "<code>--compare-base</code> / <code>--coverage-delta</code>). Those modes sn"
       & "apshot a base revision across <strong>git, Mercurial, Subversion, Fossil, an"
       & "d jj</strong> without touching the working tree. Detection is marker-file ba"
       & "sed (<code>.git</code> / <code>.jj</code> / <code>.hg</code> / <code>.svn</c"
       & "ode> / <code>.fslckout</code> / <code>_FOSSIL_</code>) with a command-probe "
       & "fallback.</p>"
       & ASCII.LF
       & "<p>Full detail, the snapshot mechanism per VCS, and the Subversion/Fossil UX"
       & " notes are in <a href=""vcs.html"">VCS support and differential assessment</a>"
       & ".</p>"
       & ASCII.LF
       & "<h3 id=""ci-threshold-gates---require-""><a class=""header"" href=""#ci-threshold"
       & "-gates---require-"">CI threshold gates (<code>--require-*</code>)</a></h3>"
       & ASCII.LF
       & "<p>The four <code>--require-*</code> flags add explicit minimum-bar checks o"
       & "n top of the DAL"
       & ASCII.LF
       & "criteria. They are off by default. When set, the assessment fails loudly"
       & ASCII.LF
       & "(exit code <code>1</code>, with an explicit <code>CI GATE:</code> reason pri"
       & "nted to the report) if the"
       & ASCII.LF
       & "target does not meet the required level:</p>"
       & ASCII.LF
       & "<pre><code class=""language-bash"">adacovex --target=. --require-spark=Platinu"
       & "m --require-docstrings=100 \"
       & ASCII.LF
       & "         --require-tests=1173 --require-proof=100"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<ul>"
       & ASCII.LF
       & "<li><code>require-spark</code> compares the honest assessed SPARK level (Sto"
       & "ne..Platinum).</li>"
       & ASCII.LF
       & "<li><code>require-docstrings</code> and <code>require-proof</code> take a pe"
       & "rcentage (0-100).</li>"
       & ASCII.LF
       & "<li><code>require-tests</code> takes a count of passing tests.</li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "<p>CI that pins a gnatprove version (manifest or global <code>adacovex.toml<"
       & "/code> pin)"
       & ASCII.LF
       & "must set these to the values that version actually achieves. A stricter"
       & ASCII.LF
       & "prover can legitimately leave more VCs unproved. As a result, gate on the"
       & ASCII.LF
       & "results of the prover you pin.</p>"
       & ASCII.LF
       & "<h3 id=""result-caching---cache----no-cache----cache-dir----cache-max""><a cla"
       & "ss=""header"" href=""#result-caching---cache----no-cache----cache-dir----cache-"
       & "max"">Result caching (<code>--cache</code> / <code>--no-cache</code> / <code>"
       & "--cache-dir</code> / <code>--cache-max</code>)</a></h3>"
       & ASCII.LF
       & "<p>adacovex persists parsed analysis results on disk, so unchanged inputs ar"
       & "e not re-scanned, re-parsed, or re-proved. Every entry is keyed by a namespa"
       & "ce prefix plus the SHA-256 of the artifact(s) it was derived from. An unchan"
       & "ged manifest/lockfile/.gpr set serves the cached dependency graph. Unchanged"
       & " HLR.md/LLR.md serve the cached requirement parses. <code>--no-cache</code> "
       & "bypasses it entirely. <code>--cache-dir</code> relocates it. <code>--cache-m"
       & "ax</code> (default <code>4096</code>) caps entries before oldest-first evict"
       & "ion.</p>"
       & ASCII.LF
       & "<p>The ANSI report shows a <code>result cache: X hit(s), Y miss(es), Z evict"
       & "ed</code> line per run. Full design (schema namespace, eviction, overflow sa"
       & "fety, <code>--target</code> normalization) is in <a href=""architecture.html#"
       & "result-caching"">Architecture "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " Result caching</a>.</p>"
       & ASCII.LF
       & "<h3 id=""--verbose""><a class=""header"" href=""#--verbose""><code>--verbose</code"
       & "></a></h3>"
       & ASCII.LF
       & "<p>Print pipeline step diagnostics to stderr.</p>"
       & ASCII.LF
       & "<h3 id=""--help-and-contextual-help""><a class=""header"" href=""#--help-and-cont"
       & "extual-help""><code>--help</code> and contextual <code>help</code></a></h3>"
       & ASCII.LF
       & "<p><code>--help</code> prints all options, defaults, and examples to stdout,"
       & " then exits. No"
       & ASCII.LF
       & "scanning or assessment is performed.</p>"
       & ASCII.LF
       & "<p><strong>Contextual help</strong>: the <code>help</code> keyword prints fl"
       & "ag/subcommand-specific text"
       & ASCII.LF
       & "instead of the full usage. The topic can be given in either order, with or"
       & ASCII.LF
       & "without the leading <code>--</code>:</p>"
       & ASCII.LF
       & "<pre><code>adacovex help serve        # or: help --serve, --serve help"
       & ASCII.LF
       & "adacovex help standard     # standard / dal / asil / class"
       & ASCII.LF
       & "adacovex help sbom         # subcommands: sbom, prove, status, man"
       & ASCII.LF
       & "adacovex help theme        # every flag has a topic (port, target, ...)"
       & ASCII.LF
       & "adacovex help              # no topic: full usage"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<p>The topic is case-insensitive and an <code>=value</code> suffix is ignore"
       & "d"
       & ASCII.LF
       & "(<code>help --standard=all</code> == <code>help standard</code>). Unknown to"
       & "pics print the full"
       & ASCII.LF
       & "usage with an "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & "Unknown topic"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & " notice. Contextual help exits <code>0</code> and never"
       & ASCII.LF
       & "scans or assesses.</p>"
       & ASCII.LF
       & "<h2 id=""strict-vs-relaxed-mode""><a class=""header"" href=""#strict-vs-relaxed-m"
       & "ode"">Strict vs relaxed mode</a></h2>"
       & ASCII.LF
       & "<div class=""table-wrapper"">"
       & ASCII.LF
       & "<table>"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr><th>Aspect</th><th>Strict (default)</th><th>Relaxed (<code>--relaxed</co"
       & "de>)</th></tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr><td>Directory exclusions</td><td><code>.git</code>, <code>obj</code>, <c"
       & "ode>tests</code>, <code>config</code>, <code>.adacovex</code> only</td><td>S"
       & "ame + <code>demo,deps,examples</code> + <code>--skip-dir</code> additions</t"
       & "d></tr>"
       & ASCII.LF
       & "<tr><td>Vendored code</td><td>Scanned and counted</td><td>Skipped</td></tr>"
       & ASCII.LF
       & "<tr><td>Patch files</td><td>Applied from <code>.adacovex/patches/</code> (do"
       & "cstrings always, SPARK proof aspects in prove mode)</td><td>Not applied</td>"
       & "</tr>"
       & ASCII.LF
       & "<tr><td>Use case</td><td>Full compliance audit</td><td>Quick assessment of p"
       & "roduction code</td></tr>"
       & ASCII.LF
       & "</tbody>"
       & ASCII.LF
       & "</table>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "<p>Patch files can carry more than docstrings. A patch with <code>SPARK_Mode"
       & "</code> /"
       & ASCII.LF
       & "<code>Pre</code> / <code>Post</code> / <code>Global</code> aspects is a <str"
       & "ong>proof patch</strong> that adds SPARK"
       & ASCII.LF
       & "contracts to vendored code in prove mode (spec patches <code>.ads</code>, an"
       & "d body"
       & ASCII.LF
       & "patches <code>.adb</code> opt the vendored body into the proof). Why they ex"
       & "ist, how"
       & ASCII.LF
       & "to write them, worked examples, and pitfalls are in"
       & ASCII.LF
       & "<a href=""proving.html#proof-patches-proving-vendored-dependencies"">Proving a"
       & "nd writing proofs "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " proof patches</a>.</p>"
       & ASCII.LF
       & "<h2 id=""exit-codes""><a class=""header"" href=""#exit-codes"">Exit codes</a></h2>"
       & ASCII.LF
       & "<div class=""table-wrapper"">"
       & ASCII.LF
       & "<table>"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr><th>Code</th><th>Meaning</th></tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr><td><code>0</code></td><td>Success (DAL achieved, all checks pass, <code"
       & ">--version</code>, man page installed/up-to-date)</td></tr>"
       & ASCII.LF
       & "<tr><td><code>1</code></td><td>Compliance failure (DAL unmet, tests failing,"
       & " a <code>--require-*</code> CI gate unmet, differential regression, <code>ma"
       & "n --check</code> finding a newer version available or none installed, and mo"
       & "re)</td></tr>"
       & ASCII.LF
       & "</tbody>"
       & ASCII.LF
       & "</table>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "<h2 id=""terminal-colour""><a class=""header"" href=""#terminal-colour"">Terminal "
       & "colour</a></h2>"
       & ASCII.LF
       & "<p>adacovex colours its terminal output (red for failures, green for passes,"
       & ASCII.LF
       & "bold for headings) so the important lines stand out.  Colour is enabled by"
       & ASCII.LF
       & "default on a normal terminal.  It is suppressed automatically when the"
       & ASCII.LF
       & "output would not take it:</p>"
       & ASCII.LF
       & "<ul>"
       & ASCII.LF
       & "<li><code>NO_COLOR</code> is set (the cross-tool opt-out convention);</li>"
       & ASCII.LF
       & "<li>a CI variable is set (GitHub Actions, GitLab CI, and more), so CI logs"
       & ASCII.LF
       & "stay plain and machine-readable;</li>"
       & ASCII.LF
       & "<li><code>TERM</code> is <code>dumb</code> (or set to an empty value).</li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "<h2 id=""the-sbom-subcommand""><a class=""header"" href=""#the-sbom-subcommand"">T"
       & "he <code>sbom</code> subcommand</a></h2>"
       & ASCII.LF
       & "<p><code>adacovex sbom</code> resolves the target project"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s dependency graph from its Alire"
       & ASCII.LF
       & "manifest, <code>alire/alire.lock</code>, and the root <code>.gpr</code> <cod"
       & "e>with</code> clauses, then writes"
       & ASCII.LF
       & "a proof-aware software bill of materials in CycloneDX 1.5 JSON or SPDX 2.3"
       & ASCII.LF
       & "JSON. It is <strong>standard-aware</strong> (it defaults to all standards), "
       & "honours"
       & ASCII.LF
       & "<code>SOURCE_DATE_EPOCH</code> for byte-for-byte deterministic output, and i"
       & "s mutually"
       & ASCII.LF
       & "exclusive with <code>--compare-base</code> / <code>--coverage-delta</code>. "
       & "Full detail (usage,"
       & ASCII.LF
       & "properties, determinism, exit codes) is in"
       & ASCII.LF
       & "<a href=""sbom.html"">The <code>sbom</code> subcommand</a>.</p>"
       & ASCII.LF
       & "<h2 id=""examples""><a class=""header"" href=""#examples"">Examples</a></h2>"
       & ASCII.LF
       & "<pre><code class=""language-bash""># Self-assessment (strict mode, 100% docs r"
       & "equired)"
       & ASCII.LF
       & "adacovex --target=."
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# ISO 26262 assessment at ASIL B (dedicated flag)"
       & ASCII.LF
       & "adacovex --target=. --asil=B"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# IEC 62304 assessment at safety Class A (dedicated flag)"
       & ASCII.LF
       & "adacovex --target=. --class=A"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# ISO 26262 assessment at rigour tier C (ASIL B) via --standard"
       & ASCII.LF
       & "adacovex --target=. --standard=iso26262 --dal=C"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# Emit badges for every standard at the shared tier"
       & ASCII.LF
       & "adacovex --target=. --standard=all"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# Report toolchain + platform status"
       & ASCII.LF
       & "adacovex status --target=."
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# Assess a CRDT library at DAL-C in relaxed mode"
       & ASCII.LF
       & "adacovex --target=../Ada_CRDT --dal=C --relaxed"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# DAL-A assessment (requires Gold SPARK)"
       & ASCII.LF
       & "adacovex --target=. --dal=A"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# Without SVG output"
       & ASCII.LF
       & "adacovex --target=../Ada_CRDT --no-svg"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# Custom skip dirs"
       & ASCII.LF
       & "adacovex --target=../Ada_CRDT --relaxed --skip-dir=vendor"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# With Markdown reports"
       & ASCII.LF
       & "adacovex --target=. --emit-markdown=docs/compliance"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# Web dashboard on custom port"
       & ASCII.LF
       & "adacovex --target=. --serve --port=9090"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# Differential assessment vs a git base revision"
       & ASCII.LF
       & "adacovex --target=. --compare-base=HEAD"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# Proof-aware SBOM (CycloneDX 1.5 JSON; all standards by default)"
       & ASCII.LF
       & "adacovex sbom --format=cyclonedx-json --target=. --dal=C"
       & ASCII.LF
       & "# SBOM for a single standard (ISO 26262 at ASIL B)"
       & ASCII.LF
       & "adacovex sbom --format=cyclonedx-json --target=. --asil=B"
       & ASCII.LF
       & "# SPDX 2.3 SBOM at IEC 62304 Class A"
       & ASCII.LF
       & "adacovex sbom --format=spdx-json --target=. --class=A --out=sbom.spdx.json"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "# Proof-aware SBOM (SPDX 2.3 JSON) at a custom path"
       & ASCII.LF
       & "adacovex sbom --format=spdx-json --out=docs/compliance/sbom.spdx.json"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "                    </main>"
       & ASCII.LF

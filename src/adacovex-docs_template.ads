       & ASCII.LF
       & "<section id=""c10-docs-reorganised-into-audience-folders"">"
       & ASCII.LF
       & "<h3>C10: Docs reorganised into audience folders<a class=""headerlink"" href=""#"
       & "c10-docs-reorganised-into-audience-folders"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF

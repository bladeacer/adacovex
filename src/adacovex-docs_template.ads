       & ASCII.LF
       & "<p>900 tests passing across 14 categories.</p>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""proof-results"">"
       & ASCII.LF
       & "<h2>Proof Results<a class=""headerlink"" href=""#proof-results"" title=""Link to "
       & "this heading"">"
       & Character'Val(194)

   --  The decoded bytes of one body: base64-decoded (the gzip
   --  stream, served with Content-Encoding: gzip) when Is_Gzip,
   --  otherwise the body verbatim.  The server streams one chunk
   --  at a time, so no worker ever materialises a multi-megabyte
   --  body.
   function Body_Bytes (B : Body_Index; Is_Gzip : Boolean)
     return String;

   --  The decoded first body of a table asset (its only body for
   --  every asset unless a compressed chunk split it).
   function Content (Idx : Asset_Index) return String;

   --  Find the asset for a request subpath.  Normalises:
   --  "" and "/" map to index.html, a trailing slash appends
   --  index.html, and an extensionless leaf tries leaf.html
   --  then leaf/index.html.  Returns 0 when absent.

   function Find (Subpath : String) return Natural;


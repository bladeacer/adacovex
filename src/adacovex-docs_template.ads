       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""c3-proof-patch-merge-engine-tests"">"
       & ASCII.LF
       & "<h3>C3: proof-patch merge engine tests<a class=""headerlink"" href=""#c3-proof-"
       & "patch-merge-engine-tests"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<p>New <code class=""docutils literal notranslate""><span class=""pre"">Proof</s"
       & "pan> <span class=""pre"">patches</span></code> test category (35 tests) coveri"
       & "ng the merge engine in"

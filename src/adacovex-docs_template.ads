  & ASCII.LF
  & "<h3 id=""outputs""><a class=""header"" href=""#outputs"">Outputs</"
  & "a></h3>"
  & ASCII.LF
  & "<div class=""table-wrapper"">"
  & ASCII.LF
  & "<table>"
  & ASCII.LF
  & "<thead>"
  & ASCII.LF
  & "<tr><th>Output</th><th>Description</th></tr>"

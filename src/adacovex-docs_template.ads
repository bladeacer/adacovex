       & ASCII.LF
       & "          <section id=""iec-62304-software-safety-classes"">"
       & ASCII.LF
       & "<h1>IEC 62304 Software Safety Classes<a class=""headerlink"" href=""#iec-62304-"
       & "software-safety-classes"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h1>"
       & ASCII.LF
       & "<p>IEC 62304 defines three software safety classes (A, B, C) for the"
       & ASCII.LF
       & "medical-device software lifecycle, ranked by the severity of the harm a"
       & ASCII.LF
       & "failure could cause. adacovex assesses compliance against all three by"
       & ASCII.LF
       & "re-labelling the same four evidence checks it computes for DO-178C: HLR"
       & ASCII.LF
       & "traceability, no orphan tags, passing tests, and a minimum SPARK proof level"
       & ".</p>"
       & ASCII.LF
       & "<section id=""level-definitions"">"
       & ASCII.LF
       & "<h2>Level Definitions<a class=""headerlink"" href=""#level-definitions"" title="""
       & "Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h2>"
       & ASCII.LF
       & "<div class=""table-wrapper colwidths-auto docutils container"">"
       & ASCII.LF
       & "<table class=""docutils align-default"">"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr class=""row-odd""><th class=""head""><p>Class</p></th>"
       & ASCII.LF
       & "<th class=""head""><p>Severity</p></th>"
       & ASCII.LF
       & "<th class=""head""><p>Possible Consequence</p></th>"
       & ASCII.LF
       & "<th class=""head""><p>Example</p></th>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p>C</p></td>"
       & ASCII.LF
       & "<td><p>Highest</p></td>"
       & ASCII.LF
       & "<td><p>Death or serious injury possible</p></td>"
       & ASCII.LF
       & "<td><p>Infusion-pump dosing, radiation-therapy control</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-odd""><td><p>B</p></td>"
       & ASCII.LF
       & "<td><p>Moderate</p></td>"
       & ASCII.LF
       & "<td><p>Non-serious injury possible</p></td>"
       & ASCII.LF
       & "<td><p>Diagnostic imaging, patient-monitor alarm logic</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p>A</p></td>"
       & ASCII.LF
       & "<td><p>Lowest</p></td>"
       & ASCII.LF
       & "<td><p>No injury or damage to health</p></td>"
       & ASCII.LF
       & "<td><p>Administrative/scheduling software, data logging</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "</tbody>"
       & ASCII.LF
       & "</table>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""assessment-criteria"">"

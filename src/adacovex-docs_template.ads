       & "<span class=""pre"">devDependencies</span></code>-only package"
       & ASCII.LF
       & "stays vendored;</p></li>"
       & ASCII.LF
       & "<li><p>Cargo <code class=""docutils literal notranslate""><span class=""pre"">[d"
       & "ev-dependencies]</span></code>, Gemfile <code class=""docutils literal notran"
       & "slate""><span class=""pre"">group</span> <span class=""pre"">:test</span></code>,"
       & " Maven"
       & ASCII.LF
       & "<code class=""docutils literal notranslate""><span class=""pre"">&lt;scope&gt;te"

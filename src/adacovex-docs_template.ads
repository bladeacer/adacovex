       & "</ul>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""c3-gnatprove-prove-subcommand-options"">"
       & ASCII.LF
       & "<h3>C3: GNATprove <code class=""docutils literal notranslate""><span class=""pr"

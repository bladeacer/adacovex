       & ASCII.LF
       & "<ul class=""simple"">"
       & ASCII.LF
       & "<li><p><strong>Part of Speech:</strong> Noun</p></li>"
       & ASCII.LF
       & "<li><p><strong>Definition:</strong> The visible declaration part of a packag"

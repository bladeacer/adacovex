       & ASCII.LF
       & "<li><p><strong>Incorrect Example:</strong> <em>The property <code class=""doc"
       & "utils literal notranslate""><span class=""pre"">Pre</span></code> states the pr"
       & "econdition.</em></p></li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""technical-name-contract"">"
       & ASCII.LF
       & "<h4>Technical Name: Contract<a class=""headerlink"" href=""#technical-name-cont"
       & "ract"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h4>"
       & ASCII.LF
       & "<ul class=""simple"">"
       & ASCII.LF
       & "<li><p><strong>Part of Speech:</strong> Noun</p></li>"
       & ASCII.LF
       & "<li><p><strong>Definition:</strong> The set of preconditions, postconditions"
       & ", and global"
       & ASCII.LF
       & "dependencies that describe subprogram behaviour for the proof tool.</p></li>"
       & ASCII.LF
       & "<li><p><strong>Approved Form:</strong> Contract (singular), Contracts (plura"

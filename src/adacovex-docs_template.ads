       & "ate""><span class=""pre"">ASIL</span> <span class=""pre"">B</span></code>, <code "
       & "class=""docutils literal notranslate""><span class=""pre"">Class</span> <span cl"
       & "ass=""pre"">A</span></code>)</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p><code class=""docutils literal notranslate""><span"
       & " class=""pre"">language</span></code></p></td>"
       & ASCII.LF
       & "<td><p>Every component</p></td>"
       & ASCII.LF
       & "<td><p>Implementation language(s) inferred from file extensions</p></td>"

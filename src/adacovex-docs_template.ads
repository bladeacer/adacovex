       & ASCII.LF
       & "<li><p><strong>Incorrect Example:</strong> <em>The proof checks that every i"
       & "nstance is initialised.</em></p></li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""technical-name-spark"">"
       & ASCII.LF
       & "<h4>Technical Name: SPARK<a class=""headerlink"" href=""#technical-name-spark"" "
       & "title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h4>"
       & ASCII.LF
       & "<ul class=""simple"">"
       & ASCII.LF
       & "<li><p><strong>Part of Speech:</strong> Noun</p></li>"
       & ASCII.LF
       & "<li><p><strong>Definition:</strong> The formally analysable subset of Ada th"
       & "at the gnatprove"
       & ASCII.LF
       & "proof tool verifies. adacovex targets the Platinum SPARK level.</p></li>"
       & ASCII.LF
       & "<li><p><strong>Approved Form:</strong> SPARK (exact capitals)</p></li>"

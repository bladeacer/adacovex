       & "<th class=""head""><p>Where it appears</p></th>"
       & ASCII.LF
       & "<th class=""head""><p>Meaning</p></th>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p><code class=""docutils literal notranslate""><span"
       & " class=""pre"">adacovex:proof_level</span></code></p></td>"
       & ASCII.LF
       & "<td><p>Root component</p></td>"
       & ASCII.LF
       & "<td><p>Assessed SPARK level (<code class=""docutils literal notranslate""><spa"

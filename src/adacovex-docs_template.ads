       & ASCII.LF
       & "meant)</p></li>"
       & ASCII.LF
       & "<li><p><strong>Correct Example:</strong> <em>The target reaches <strong>Plat"
       & "inum</strong>, the highest SPARK level.</em></p></li>"
       & ASCII.LF
       & "<li><p><strong>Incorrect Example:</strong> <em>The target reaches Platinum, "
       & "the highest grade.</em></p></li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""technical-name-coverage"">"
       & ASCII.LF
       & "<h4>Technical Name: Coverage<a class=""headerlink"" href=""#technical-name-cove"
       & "rage"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h4>"
       & ASCII.LF
       & "<ul class=""simple"">"
       & ASCII.LF
       & "<li><p><strong>Part of Speech:</strong> Noun</p></li>"
       & ASCII.LF
       & "<li><p><strong>Definition:</strong> The percentage of subprograms that have "
       & "a docstring, out of"
       & ASCII.LF
       & "all subprograms in the scanned source tree.</p></li>"
       & ASCII.LF

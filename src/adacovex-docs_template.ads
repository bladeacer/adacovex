       & "<span class=""w"">  </span><span class=""nt"">push</span><span class=""p"">:</span"
       & ">"
       & ASCII.LF
       & "<span class=""w"">    </span><span class=""nt"">branches</span><span class=""p"">:"
       & "</span><span class=""w""> </span><span class=""p p-Indicator"">[</span><span cla"
       & "ss=""nv"">main</span><span class=""p p-Indicator"">]</span>"
       & ASCII.LF
       & "<span class=""w"">  </span><span class=""nt"">pull_request</span><span class=""p"""
       & ">:</span>"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "<span class=""nt"">jobs</span><span class=""p"">:</span>"
       & ASCII.LF
       & "<span class=""w"">  </span><span class=""nt"">adacovex</span><span class=""p"">:</"
       & "span>"
       & ASCII.LF
       & "<span class=""w"">    </span><span class=""nt"">runs-on</span><span class=""p"">:<"
       & "/span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">ubuntu"
       & "-latest</span>"
       & ASCII.LF
       & "<span class=""w"">    </span><span class=""nt"">steps</span><span class=""p"">:</s"
       & "pan>"
       & ASCII.LF
       & "<span class=""w"">      </span><span class=""p p-Indicator"">-</span><span class"
       & "=""w""> </span><span class=""nt"">uses</span><span class=""p"">:</span><span class"
       & "=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">actions/checkout@v7</sp"
       & "an>"
       & ASCII.LF
       & "<span class=""w"">      </span><span class=""p p-Indicator"">-</span><span class"
       & "=""w""> </span><span class=""nt"">uses</span><span class=""p"">:</span><span class"
       & "=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">bladeacer/adacovex@v1</"
       & "span>"
       & ASCII.LF
       & "<span class=""w"">        </span><span class=""nt"">with</span><span class=""p"">:"
       & "</span>"
       & ASCII.LF
       & "<span class=""w"">          </span><span class=""nt"">target</span><span class="""
       & "p"">:</span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">."
       & "</span>"
       & ASCII.LF
       & "<span class=""w"">          </span><span class=""nt"">standard</span><span class"
       & "=""p"">:</span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"""
       & ">all</span><span class=""w"">          </span><span class=""c1""># DO-178C + ISO"
       & " 26262 + IEC 62304</span>"
       & ASCII.LF
       & "<span class=""w"">          </span><span class=""nt"">require-spark</span><span "
       & "class=""p"">:</span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-P"
       & "lain"">Platinum</span>"
       & ASCII.LF
       & "<span class=""w"">          </span><span class=""nt"">require-docstrings</span><"
       & "span class=""p"">:</span><span class=""w""> </span><span class=""l l-Scalar l-Sca"
       & "lar-Plain"">100</span>"
       & ASCII.LF
       & "<span class=""w"">          </span><span class=""nt"">require-tests</span><span "
       & "class=""p"">:</span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-P"
       & "lain"">1186</span>"
       & ASCII.LF
       & "<span class=""w"">          </span><span class=""nt"">run-tests</span><span clas"
       & "s=""p"">:</span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"
       & """>true</span>"
       & ASCII.LF
       & "<span class=""w"">          </span><span class=""nt"">generate-sbom</span><span "
       & "class=""p"">:</span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-P"
       & "lain"">true</span>"
       & ASCII.LF
       & "</pre></div>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "<p>This job builds adacovex. It runs the target"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s native tests and the full"
       & ASCII.LF
       & "assessment. It gates on Platinum SPARK, 100% docstring coverage, and 900"
       & ASCII.LF
       & "passing tests. On failure, the job publishes <code class=""docutils literal n"
       & "otranslate""><span class=""pre"">adacovex-assessment</span></code> artifacts"
       & ASCII.LF
       & "and Markdown summaries.</p>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""pr-coverage-gate"">"
       & ASCII.LF
       & "<h3>PR coverage gate<a class=""headerlink"" href=""#pr-coverage-gate"" title=""Li"
       & "nk to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<p>Use <code class=""docutils literal notranslate""><span class=""pre"">--covera"
       & "ge-delta</span></code> to fail PRs that drop docstring coverage:</p>"
       & ASCII.LF
       & "<div class=""highlight-yaml notranslate""><div class=""highlight""><pre><span></"
       & "span><span class=""c1""># .github/workflows/pr-coverage.yml</span>"
       & ASCII.LF
       & "<span class=""nt"">on</span><span class=""p"">:</span>"
       & ASCII.LF
       & "<span class=""w"">  </span><span class=""nt"">pull_request</span><span class=""p"""
       & ">:</span>"
       & ASCII.LF
       & ""
       & ASCII.LF
       & "<span class=""nt"">jobs</span><span class=""p"">:</span>"
       & ASCII.LF
       & "<span class=""w"">  </span><span class=""nt"">coverage-delta</span><span class="""
       & "p"">:</span>"
       & ASCII.LF
       & "<span class=""w"">    </span><span class=""nt"">runs-on</span><span class=""p"">:<"
       & "/span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">ubuntu"
       & "-latest</span>"
       & ASCII.LF
       & "<span class=""w"">    </span><span class=""nt"">steps</span><span class=""p"">:</s"
       & "pan>"
       & ASCII.LF
       & "<span class=""w"">      </span><span class=""p p-Indicator"">-</span><span class"
       & "=""w""> </span><span class=""nt"">uses</span><span class=""p"">:</span><span class"
       & "=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">actions/checkout@v7</sp"
       & "an>"
       & ASCII.LF
       & "<span class=""w"">        </span><span class=""nt"">with</span><span class=""p"">:"
       & "</span>"
       & ASCII.LF
       & "<span class=""w"">          </span><span class=""nt"">fetch-depth</span><span cl"
       & "ass=""p"">:</span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-Pla"
       & "in"">0</span>"
       & ASCII.LF
       & "<span class=""w"">      </span><span class=""p p-Indicator"">-</span><span class"
       & "=""w""> </span><span class=""nt"">uses</span><span class=""p"">:</span><span class"
       & "=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">bladeacer/adacovex@v1</"
       & "span>"
       & ASCII.LF
       & "<span class=""w"">        </span><span class=""nt"">with</span><span class=""p"">:"
       & "</span>"
       & ASCII.LF
       & "<span class=""w"">          </span><span class=""nt"">target</span><span class="""
       & "p"">:</span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">."
       & "</span>"
       & ASCII.LF
       & "<span class=""w"">          </span><span class=""nt"">coverage-delta</span><span"
       & " class=""p"">:</span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-"
       & "Plain"">${{ github.event.pull_request.base.sha }}</span>"
       & ASCII.LF
       & "</pre></div>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""release-workflow"">"
       & ASCII.LF
       & "<h3>Release workflow<a class=""headerlink"" href=""#release-workflow"" title=""Li"
       & "nk to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<p>Tag a release. The bundled workflow (<code class=""docutils literal notran"
       & "slate""><span class=""pre"">release.yml</span></code>) builds the binary and ru"
       & "ns GNATprove. It validates the self-assessment. It publishes `adacovex-vX.</"
       & "p>"
       & ASCII.LF
       & "<p>Y. Z.tar.gz<code class=""docutils literal notranslate""> <span class=""pre"">"
       & "and</span> <span class=""pre"">the</span> <span class=""pre"">composite</span> <"
       & "span class=""pre"">action</span> <span class=""pre"">bundle.</span> <span class="
       & """pre"">Floating</span> <span class=""pre"">tags</span> <span class=""pre"">(</spa"
       & "n></code>&#64;latest<code class=""docutils literal notranslate""><span class="""
       & "pre"">,</span> </code>&#64;v1<code class=""docutils literal notranslate""><span"
       & " class=""pre"">,</span> </code>&#64;v1.3<code class=""docutils literal notransl"
       & "ate""><span class=""pre"">)</span> <span class=""pre"">always</span> <span class="
       & """pre"">point</span> <span class=""pre"">at</span> <span class=""pre"">the</span> "
       & "<span class=""pre"">newest</span> <span class=""pre"">release.</span> <span clas"
       & "s=""pre"">Pin</span> </code>&#64;vX.</p>"
       & ASCII.LF
       & "<p>Y. Z` for reproducibility.</p>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""gitlab-ci"">"
       & ASCII.LF
       & "<h2>GitLab CI<a class=""headerlink"" href=""#gitlab-ci"" title=""Link to this hea"
       & "ding"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h2>"
       & ASCII.LF
       & "<p>The same inputs map to GitLab CI variables:</p>"
       & ASCII.LF
       & "<div class=""highlight-yaml notranslate""><div class=""highlight""><pre><span></"
       & "span><span class=""c1""># .gitlab-ci.yml</span>"
       & ASCII.LF
       & "<span class=""nt"">adacovex</span><span class=""p"">:</span>"
       & ASCII.LF
       & "<span class=""w"">  </span><span class=""nt"">image</span><span class=""p"">:</spa"
       & "n><span class=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">ubuntu:lat"
       & "est</span>"
       & ASCII.LF
       & "<span class=""w"">  </span><span class=""nt"">before_script</span><span class=""p"
       & """>:</span>"
       & ASCII.LF
       & "<span class=""w"">    </span><span class=""p p-Indicator"">-</span><span class="""
       & "w""> </span><span class=""l l-Scalar l-Scalar-Plain"">apt-get update -qq &amp;&"
       & "amp; apt-get install -y -qq curl</span>"
       & ASCII.LF
       & "<span class=""w"">    </span><span class=""p p-Indicator"">-</span><span class="""
       & "w""> </span><span class=""l l-Scalar l-Scalar-Plain"">curl -fsSL https://raw.gi"
       & "thubusercontent.com/bladeacer/adacovex/main/install.sh | bash</span>"
       & ASCII.LF
       & "<span class=""w"">  </span><span class=""nt"">script</span><span class=""p"">:</sp"
       & "an>"
       & ASCII.LF
       & "<span class=""w"">    </span><span class=""p p-Indicator"">-</span><span class="""
       & "w""> </span><span class=""l l-Scalar l-Scalar-Plain"">adacovex --target=. --sta"
       & "ndard=all --dal=C --require-spark=Platinum --require-docstrings=100</span>"
       & ASCII.LF
       & "<span class=""w"">  </span><span class=""nt"">artifacts</span><span class=""p"">:<"
       & "/span>"
       & ASCII.LF
       & "<span class=""w"">    </span><span class=""nt"">when</span><span class=""p"">:</sp"
       & "an><span class=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">always</s"
       & "pan>"
       & ASCII.LF
       & "<span class=""w"">    </span><span class=""nt"">paths</span><span class=""p"">:</s"
       & "pan>"
       & ASCII.LF
       & "<span class=""w"">      </span><span class=""p p-Indicator"">-</span><span class"
       & "=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">sbom.json</span>"
       & ASCII.LF
       & "<span class=""w"">      </span><span class=""p p-Indicator"">-</span><span class"
       & "=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">docs/badges/*.svg</span"
       & ">"
       & ASCII.LF
       & "</pre></div>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "<p>If your runner already has Alire, replace the <code class=""docutils liter"
       & "al notranslate""><span class=""pre"">install.sh</span></code> step with"
       & ASCII.LF
       & "<code class=""docutils literal notranslate""><span class=""pre"">alr</span> <spa"
       & "n class=""pre"">install</span> <span class=""pre"">covex</span> <span class=""pre"
       & """>gnatprove</span></code>.</p>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""other-ci-systems"">"
       & ASCII.LF
       & "<h2>Other CI systems<a class=""headerlink"" href=""#other-ci-systems"" title=""Li"
       & "nk to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h2>"
       & ASCII.LF
       & "<p>The action is a pure composite of shell steps. It works on any runner tha"
       & "t can"
       & ASCII.LF
       & "run <code class=""docutils literal notranslate""><span class=""pre"">bash</span>"
       & "</code> and install Alire:</p>"
       & ASCII.LF
       & "<ol class=""arabic simple"">"
       & ASCII.LF
       & "<li><p>Install Alire + GNAT (<code class=""docutils literal notranslate""><spa"
       & "n class=""pre"">alr</span> <span class=""pre"">toolchain</span> <span class=""pre"
       & """>--install</span> <span class=""pre"">gnat_native</span></code>).</p></li>"
       & ASCII.LF
       & "<li><p>Download the release bundle or build from source.</p></li>"
       & ASCII.LF
       & "<li><p>Run <code class=""docutils literal notranslate""><span class=""pre"">adac"
       & "ovex</span></code> with the same flags as the GitHub Action inputs.</p></li>"
       & ASCII.LF
       & "</ol>"
       & ASCII.LF
       & "<p>The JSON API (<code class=""docutils literal notranslate""><span class=""pre"
       & """>/api/metrics</span></code> when using <code class=""docutils literal notran"
       & "slate""><span class=""pre"">--serve</span></code>, or <code class=""docutils lit"
       & "eral notranslate""><span class=""pre"">--emit-metrics</span></code>) lets"
       & ASCII.LF
       & "you parse results in any language.</p>"
       & ASCII.LF
       & "<p><strong>Action/CLI/docs parity is a feature gate.</strong> CI runs the ac"
       & "tion-parity"
       & ASCII.LF
       & "check (<code class=""docutils literal notranslate""><span class=""pre"">tools/ch"
       & "eck-action-parity.py</span></code>), which fails when the action"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s inputs"
       & ASCII.LF
       & "stop mirroring the base CLI option set, and also fails when the <code class="
       & """docutils literal notranslate""><span class=""pre"">###</span> <span class=""pre"
       & """>Inputs</span></code>"
       & ASCII.LF
       & "table below drifts from <code class=""docutils literal notranslate""><span cla"
       & "ss=""pre"">action.yml</span></code>. See <code class=""docutils literal notrans"
       & "late""><span class=""pre"">tools/check-action-parity.py</span></code> for"
       & ASCII.LF
       & "the mapping rules (maintainers run the same check locally via"
       & ASCII.LF
       & "<code class=""docutils literal notranslate""><span class=""pre"">make</span> <sp"
       & "an class=""pre"">action-parity-check</span></code>; see the <a class=""referenc"
       & "e internal"" href=""../contributing/developer-guide.html""><span class=""std std"
       & "-doc"">developer guide</span></a>).</p>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""composite-action-action-yml"">"
       & ASCII.LF
       & "<h2>Composite action (<code class=""docutils literal notranslate""><span class"
       & "=""pre"">./action.yml</span></code>)<a class=""headerlink"" href=""#composite-act"
       & "ion-action-yml"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h2>"
       & ASCII.LF
       & "<p>The composite action installs Alire via"
       & ASCII.LF
       & "<a class=""reference external"" href=""https://github.com/alire-project/setup-a"
       & "lire""><code class=""docutils literal notranslate""><span class=""pre"">alire-pro"
       & "ject/setup-alire</span></code></a>."
       & ASCII.LF
       & "GNAT comes from <code class=""docutils literal notranslate""><span class=""pre"""
       & ">gnat-version</span></code> plus <code class=""docutils literal notranslate"">"
       & "<span class=""pre"">gprbuild</span></code>. <code class=""docutils literal notr"
       & "anslate""><span class=""pre"">gnatprove</span></code> is NOT an"
       & ASCII.LF
       & "<code class=""docutils literal notranslate""><span class=""pre"">alr</span> <spa"
       & "n class=""pre"">toolchain</span></code> component. The <code class=""docutils l"
       & "iteral notranslate""><span class=""pre"">prove</span></code> subcommand resolve"
       & "s it through the"
       & ASCII.LF
       & "target project"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s manifest, <code class=""docutils literal notranslate""><span class=""pre"">$PA"
       & "TH</span></code>, cached toolchain, or download.</p>"
       & ASCII.LF
       & "<p>The action obtains the version-matched adacovex binary. It downloads the"
       & ASCII.LF
       & "release bundle by default. You can set <code class=""docutils literal notrans"
       & "late""><span class=""pre"">build:</span> <span class=""pre"">true</span></code> t"
       & "o build from source.</p>"
       & ASCII.LF
       & "<p>Optionally, the action runs GNATprove (<code class=""docutils literal notr"
       & "anslate""><span class=""pre"">prove</span></code>) and the native tests"
       & ASCII.LF
       & "(<code class=""docutils literal notranslate""><span class=""pre"">run-tests</spa"
       & "n></code>). Then it runs the assessment. It generates a proof-aware SBOM"
       & ASCII.LF
       & "(<code class=""docutils literal notranslate""><span class=""pre"">generate-sbom<"
       & "/span></code>, default <code class=""docutils literal notranslate""><span clas"
       & "s=""pre"">true</span></code>). It publishes a Markdown step summary,"
       & ASCII.LF
       & "machine-readable outputs, and SVG badge artifacts.</p>"
       & ASCII.LF
       & "<p><code class=""docutils literal notranslate""><span class=""pre"">run-tests</s"
       & "pan></code> <strong>builds the target"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s native test suite first</strong>. In a consumer"
       & ASCII.LF
       & "workspace, the <code class=""docutils literal notranslate""><span class=""pre"">"
       & "build:</span> <span class=""pre"">true</span></code> step builds adacovex in a"
       & " scratch checkout. It"
       & ASCII.LF
       & "leaves the target untouched.</p>"
       & ASCII.LF
       & "<p>The action runs <code class=""docutils literal notranslate""><span class=""p"
       & "re"">alr</span> <span class=""pre"">build</span></code> in the target root befo"
       & "re executing"
       & ASCII.LF
       & "<code class=""docutils literal notranslate""><span class=""pre"">test-command</s"
       & "pan></code>. The target root is a subdirectory when <code class=""docutils li"
       & "teral notranslate""><span class=""pre"">target</span></code> points at one."
       & ASCII.LF
       & "In the self-assessment case, the build is an incremental no-op.</p>"
       & ASCII.LF
       & "<p>This design keeps <code class=""docutils literal notranslate""><span class="
       & """pre"">test-command:</span> <span class=""pre"">./test_crdt</span></code>-style"
       & " usage working in consumer"
       & ASCII.LF
       & "repositories such as Ada_CRDT"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s release workflow.</p>"
       & ASCII.LF
       & "<p>The action is version-matched to the adacovex binary. The release workflo"
       & "w bundles <code class=""docutils literal notranslate""><span class=""pre"">adaco"
       & "vex-vX.</span> <span class=""pre"">Y.</span> <span class=""pre"">Z.tar.gz</span>"
       & "</code> for every `vX.</p>"
       & ASCII.LF
       & "<p>Y. Z` tag. The action downloads the binary for the tag it is referenced b"
       & "y. Reference it by a floating tag to always get the latest published release"
       & ".</p>"
       & ASCII.LF
       & "<p>You can pin to an exact release for reproducibility:</p>"
       & ASCII.LF
       & "<div class=""highlight-yaml notranslate""><div class=""highlight""><pre><span></"
       & "span><span class=""nt"">steps</span><span class=""p"">:</span>"
       & ASCII.LF
       & "<span class=""w"">  </span><span class=""p p-Indicator"">-</span><span class=""w"""
       & "> </span><span class=""nt"">uses</span><span class=""p"">:</span><span class=""w"""
       & "> </span><span class=""l l-Scalar l-Scalar-Plain"">actions/checkout@v7</span>"
       & ASCII.LF
       & "<span class=""w"">  </span><span class=""p p-Indicator"">-</span><span class=""w"""
       & "> </span><span class=""nt"">uses</span><span class=""p"">:</span><span class=""w"""
       & "> </span><span class=""l l-Scalar l-Scalar-Plain"">bladeacer/adacovex@v1</span"
       & ">"
       & ASCII.LF
       & "<span class=""w"">    </span><span class=""nt"">with</span><span class=""p"">:</sp"
       & "an>"
       & ASCII.LF
       & "<span class=""w"">      </span><span class=""nt"">target</span><span class=""p"">:"
       & "</span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">.</sp"
       & "an>"
       & ASCII.LF
       & "<span class=""w"">      </span><span class=""nt"">standard</span><span class=""p"""
       & ">:</span><span class=""w""> </span><span class=""l l-Scalar l-Scalar-Plain"">all"
       & "</span><span class=""w"">   </span><span class=""c1""># badges/reports for DO-17"
       & "8C + ISO 26262 + IEC 62304</span>"
       & ASCII.LF
       & "</pre></div>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "<section id=""inputs"">"
       & ASCII.LF
       & "<h3>Inputs<a class=""headerlink"" href=""#inputs"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)

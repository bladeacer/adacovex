       & ASCII.LF
       & "<h1>Low-Level Requirements "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " adacovex<a class=""headerlink"" href=""#low-level-requirements-adacovex"" title"

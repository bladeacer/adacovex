       & ASCII.LF
       & "<section id=""c4-dependency-hierarchy-alternative-view-with-vendored-nomnoml-"
       & "and-graphre"">"
       & ASCII.LF
       & "<h3>C4: Dependency hierarchy alternative view with vendored nomnoml and grap"

                  & "re-tests</code></li>"
                  & ASCII.LF
                  & "<li><a href=""target-projects.html"">Target project requirements</a> "
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(147)
                  & " what a project must provide</li>"
                  & ASCII.LF
                  & "<li><a href=""architecture.html#proof-patches-spark-contracts-over-vendored-d"
                  & "ependencies"">Architecture "
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(147)
                  & " proof patches</a>"
                  & ASCII.LF
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(147)
                  & " the design, the merge engine, and the patched-copy pipeline</li>"
                  & ASCII.LF
                  & "<li><a href=""proof/16.1.0-ledger.html"">The proof ledger</a> "
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(147)
                  & " how adacovex"
                  & Character'Val(226)
                  & Character'Val(128)
                  & Character'Val(153)
                  & "s own 487-VC"
                  & ASCII.LF
                  & "proof is tracked</li>"
                  & ASCII.LF
                  & "</ul>"

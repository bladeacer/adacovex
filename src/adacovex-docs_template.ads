       & "ult"">type Complexity_Result</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type Complexity_Result is record"
       & ASCII.LF
       & "Files      : File_Vectors.Vector;"
       & ASCII.LF
       & "Total_LOC  : Natural := 0;"
       & ASCII.LF
       & "Violations : Violation_Vectors.Vector;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-file_metrics""><a class=""header"" href=""#type-file_metrics"">type "
       & "File_Metrics</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type File_Metrics is record"
       & ASCII.LF
       & "Path          : String (1 .. 4096);"
       & ASCII.LF
       & "Path_Len      : Natural := 0;"
       & ASCII.LF
       & "LOC           : Natural := 0;"
       & ASCII.LF
       & "Complexity    : Natural := 0;"
       & ASCII.LF
       & "Total_Lines   : Natural := 0;"
       & ASCII.LF
       & "Code_Lines    : Natural := 0;"
       & ASCII.LF
       & "Comment_Lines : Natural := 0;"
       & ASCII.LF
       & "Blank_Lines   : Natural := 0;"
       & ASCII.LF
       & "Language      : String (1 .. 16);"
       & ASCII.LF
       & "Language_Len  : Natural := 0;"
       & ASCII.LF
       & "Subs          : Subprogram_Vectors.Vector;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-subprogram_info""><a class=""header"" href=""#type-subprogram_info"""
       & ">type Subprogram_Info</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type Subprogram_Info is record"
       & ASCII.LF
       & "Name       : String (1 .. 128);"
       & ASCII.LF
       & "Name_Len   : Natural := 0;"
       & ASCII.LF
       & "Line       : Natural := 0;"
       & ASCII.LF
       & "Complexity : Natural := 0;"
       & ASCII.LF
       & "LOC        : Natural := 0;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-violation""><a class=""header"" href=""#type-violation"">type Violat"
       & "ion</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type Violation is record"
       & ASCII.LF
       & "File_Path : String (1 .. 4096);"
       & ASCII.LF
       & "File_Len  : Natural := 0;"
       & ASCII.LF
       & "Message   : String (1 .. Max_Message);"
       & ASCII.LF
       & "Msg_Len   : Natural := 0;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"

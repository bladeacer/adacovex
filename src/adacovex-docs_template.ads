       & ASCII.LF
       & "rigor tier:</p>"
       & ASCII.LF
       & "<div class=""table-wrapper colwidths-auto docutils container"">"
       & ASCII.LF
       & "<table class=""docutils align-default"">"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr class=""row-odd""><th class=""head""><p>Standard</p></th>"

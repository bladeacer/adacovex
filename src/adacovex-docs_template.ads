       & Character'Val(156)
       & "Generated by adacovex"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & ASCII.LF
       & "line, and two obvious links "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " <strong>Documentation (offline manual)</strong> (<code class=""docutils lite"
       & "ral notranslate""><span class=""pre"">/docs</span></code>)"
       & ASCII.LF
       & "and <strong>Explore the API</strong> (jumps to the API tab) "

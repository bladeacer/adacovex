       & "<h3>type Assessment_Result<a class=""headerlink"" href=""#type-assessment-resul"
       & "t"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<div class=""highlight-ada notranslate""><div class=""highlight""><pre><span></s"
       & "pan><span class=""kd"">type</span> <span class=""kt"">Assessment_Result</span> <"
       & "span class=""kr"">is</span> <span class=""kr"">record</span>"
       & ASCII.LF
       & "<span class=""kd"">Package</span><span class=""nc"">s</span>     <span class=""p"""
       & ">:</span> <span class=""nc"">Natural</span> <span class=""p"">:=</span> <span cl"
       & "ass=""nc"">0</span><span class=""p"">;</span>"
       & ASCII.LF
       & "<span class=""n"">Subprograms</span>  <span class=""p"">:</span> <span class=""kt"
       & """>Natural</span> <span class=""p"">:=</span> <span class=""mi"">0</span><span cl"
       & "ass=""p"">;</span>"
       & ASCII.LF
       & "<span class=""n"">Documented</span>   <span class=""p"">:</span> <span class=""kt"
       & """>Natural</span> <span class=""p"">:=</span> <span class=""mi"">0</span><span cl"
       & "ass=""p"">;</span>"
       & ASCII.LF
       & "<span class=""n"">Coverage_Pct</span> <span class=""p"">:</span> <span class=""kt"
       & """>Natural</span> <span class=""p"">:=</span> <span class=""mi"">0</span><span cl"
       & "ass=""p"">;</span>"
       & ASCII.LF
       & "<span class=""n"">HLR_Total</span>    <span class=""p"">:</span> <span class=""kt"
       & """>Natural</span> <span class=""p"">:=</span> <span class=""mi"">0</span><span cl"
       & "ass=""p"">;</span>"
       & ASCII.LF
       & "<span class=""n"">HLR_Found</span>    <span class=""p"">:</span> <span class=""kt"
       & """>Natural</span> <span class=""p"">:=</span> <span class=""mi"">0</span><span cl"
       & "ass=""p"">;</span>"
       & ASCII.LF
       & "<span class=""n"">Orphan_Tags</span>  <span class=""p"">:</span> <span class=""kt"
       & """>Boolean</span> <span class=""p"">:=</span> <span class=""kc"">False</span><spa"
       & "n class=""p"">;</span>"
       & ASCII.LF
       & "<span class=""n"">Has_Proof</span>    <span class=""p"">:</span> <span class=""kt"
       & """>Boolean</span> <span class=""p"">:=</span> <span class=""kc"">False</span><spa"
       & "n class=""p"">;</span>"
       & ASCII.LF
       & "<span class=""n"">Total_VCs</span>    <span class=""p"">:</span> <span class=""kt"
       & """>Natural</span> <span class=""p"">:=</span> <span class=""mi"">0</span><span cl"
       & "ass=""p"">;</span>"

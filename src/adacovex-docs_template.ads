       & " H2 standards=all badge completeness.</p></li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "<p>See <code class=""docutils literal notranslate""><span class=""pre"">docs/cli"
       & "-reference.md</span></code>, <code class=""docutils literal notranslate""><spa"
       & "n class=""pre"">docs/ci-cd.md</span></code>, <code class=""docutils literal not"
       & "ranslate""><span class=""pre"">docs/architecture.md</span></code>.</p>"
       & ASCII.LF

       & "<thead>"
       & ASCII.LF
       & "<tr><th>Parameter</th><th>Description</th></tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr><td><code>Target_Dir</code></td><td>Target project root.</td></tr>"
       & ASCII.LF
       & "</tbody>"
       & ASCII.LF
       & "</table>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "<p><strong>Returns:</strong> Number of proof-carrying patch files.</p>"
       & ASCII.LF
       & "<h3 id=""function-has_proof-text--standardstring-return-standardboolean""><a c"
       & "lass=""header"" href=""#function-has_proof-text--standardstring-return-standard"

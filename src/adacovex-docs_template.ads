       & Character'Val(182)
       & "</a></h4>"
       & ASCII.LF
       & "<ul class=""simple"">"
       & ASCII.LF
       & "<li><p><strong>Part of Speech:</strong> Noun</p></li>"
       & ASCII.LF
       & "<li><p><strong>Definition:</strong> A declaration-level property in Ada 2012"

       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "<p><strong>Returns:</strong> Installed page version (for example "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & "1.10.0"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & ") or "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & ".</p>"
       & ASCII.LF
       & "</section>"

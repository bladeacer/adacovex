       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<p>The dependency tree nodes now have <code class=""docutils literal notransl"
       & "ate""><span class=""pre"">margin:</span> <span class=""pre"">8px</span> <span cla"
       & "ss=""pre"">0</span></code> and <code class=""docutils literal notranslate""><spa"
       & "n class=""pre"">padding:</span> <span class=""pre"">10px</span> <span class=""pre"
       & """>14px</span></code>"

       & "span class=""p"">:</span><span class=""o"">&lt;</span><span class=""n"">port</span"
       & "><span class=""o"">&gt;</span> <span class=""p"">(</span><span class=""k"">if</spa"
       & "n> <span class=""o"">--</span><span class=""n"">serve</span><span class=""p"">;</s"
       & "pan> <span class=""n"">serves</span> <span class=""n"">the</span> <span class=""n"

       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""c9-per-standard-reference-pages"">"
       & ASCII.LF
       & "<h3>C9: Per-standard reference pages<a class=""headerlink"" href=""#c9-per-stan"
       & "dard-reference-pages"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<p>Each standard now has a dedicated reference page mirroring the existing"
       & ASCII.LF
       & "DO-178C one: <code class=""docutils literal notranslate""><span class=""pre"">do"

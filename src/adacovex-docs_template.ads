       & "ss=""headerlink"" href=""#c4-proof-surface-expansion-9-additional-pure-function"
       & "s-proved-487-720-vcs-platinum-held"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<p>The audit"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)

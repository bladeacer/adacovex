       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<ul class=""simple"">"
       & ASCII.LF
       & "<li><p><strong>Proof scope is the target"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)

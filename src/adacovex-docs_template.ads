       & " class=""docutils literal notranslate""><span class=""pre"">IEC</span> <span cla"
       & "ss=""pre"">62304</span></code>)</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p><code class=""docutils literal notranslate""><span"

       & ASCII.LF
       & "<span class=""mf"">10.</span> <span class=""n"">Emit</span> <span class=""n"">SVG<"
       & "/span> <span class=""n"">badges</span>          <span class=""o"">-&gt;</span> <"
       & "span class=""o"">&lt;</span><span class=""n"">svg</span><span class=""o"">-</span>"
       & "<span class=""nb"">dir</span><span class=""o"">&gt;/*.</span><span class=""n"">svg"
       & "</span> <span class=""p"">(</span><span class=""k"">if</span> <span class=""n"">en"
       & "abled</span><span class=""p"">)</span>"
       & ASCII.LF
       & "<span class=""mf"">11.</span> <span class=""n"">Emit</span> <span class=""n"">Mark"
       & "down</span> <span class=""n"">reports</span>    <span class=""o"">-&gt;</span> <"
       & "span class=""o"">&lt;</span><span class=""n"">md</span><span class=""o"">-</span><"
       & "span class=""nb"">dir</span><span class=""o"">&gt;/</span><span class=""n"">VERIFI"
       & "CATION</span><span class=""o"">.</span><span class=""n"">md</span> <span class="""
       & "o"">+</span> <span class=""n"">TRACE</span><span class=""o"">.</span><span class="
       & """n"">md</span> <span class=""p"">(</span><span class=""k"">if</span> <span class="
       & """n"">enabled</span><span class=""p"">)</span>"
       & ASCII.LF
       & "<span class=""mf"">12.</span> <span class=""n"">Emit</span> <span class=""n"">auto"
       & "matic</span> <span class=""n"">SBOM</span>      <span class=""o"">-&gt;</span> <"
       & "span class=""o"">&lt;</span><span class=""n"">target</span><span class=""o"">&gt;/"
       & "</span><span class=""n"">sbom</span><span class=""o"">.</span><span class=""n"">js"
       & "on</span> <span class=""o"">|</span> <span class=""n"">sbom</span><span class=""o"
       & """>.</span><span class=""n"">spdx</span><span class=""o"">.</span><span class=""n"""
       & ">json</span> <span class=""o"">|</span> <span class=""n"">docs</span><span class"
       & "=""o"">/</span><span class=""n"">compliance</span><span class=""o"">/</span><span "
       & "class=""n"">SBOM</span><span class=""o"">.</span><span class=""n"">md</span> <span"
       & " class=""p"">(</span><span class=""n"">unless</span> <span class=""o"">--</span><s"
       & "pan class=""n"">no</span><span class=""o"">-</span><span class=""n"">sbom</span><s"
       & "pan class=""p"">)</span>"
       & ASCII.LF
       & "<span class=""mf"">13.</span> <span class=""n"">Start</span> <span class=""n"">HTT"

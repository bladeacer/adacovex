       & Character'Val(128)
       & Character'Val(147)
       & "  Args:"
       & ASCII.LF
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "      X (int):  First operand."
       & ASCII.LF
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "  Returns:"
       & ASCII.LF
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "      The sum."
       & ASCII.LF
       & "An "

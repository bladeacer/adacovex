       & ASCII.LF
       & "<li><p><strong>Incorrect Example:</strong> <em>The verification has zero unp"
       & "roved verification conditions.</em></p></li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""technical-name-spark-level"">"
       & ASCII.LF
       & "<h4>Technical Name: SPARK Level<a class=""headerlink"" href=""#technical-name-s"
       & "park-level"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h4>"
       & ASCII.LF
       & "<ul class=""simple"">"
       & ASCII.LF
       & "<li><p><strong>Part of Speech:</strong> Noun</p></li>"
       & ASCII.LF
       & "<li><p><strong>Definition:</strong> One of the five SPARK assurance levels: "
       & "Stone, Bronze,"
       & ASCII.LF
       & "Silver, Gold, and Platinum. Each level builds on the previous one.</p></li>"
       & ASCII.LF
       & "<li><p><strong>Approved Form:</strong> SPARK Level (singular), SPARK Levels "

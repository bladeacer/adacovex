       & ASCII.LF
       & "          <section id=""docstring-annotation-specification"">"
       & ASCII.LF
       & "<h1>Docstring Annotation Specification<a class=""headerlink"" href=""#docstring"
       & "-annotation-specification"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h1>"
       & ASCII.LF
       & "<section id=""supported-tags"">"
       & ASCII.LF
       & "<h2>Supported Tags<a class=""headerlink"" href=""#supported-tags"" title=""Link t"
       & "o this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h2>"
       & ASCII.LF
       & "<p>Tags are placed immediately before the subprogram declaration (canonical "
       & "Ada"
       & ASCII.LF
       & "convention). Placement is also supported after the declaration for backward"
       & ASCII.LF
       & "compatibility. No blank lines between tags and declaration.</p>"
       & ASCII.LF
       & "<div class=""table-wrapper colwidths-auto docutils container"">"
       & ASCII.LF
       & "<table class=""docutils align-default"">"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr class=""row-odd""><th class=""head""><p>Tag</p></th>"
       & ASCII.LF
       & "<th class=""head""><p>Format</p></th>"
       & ASCII.LF
       & "<th class=""head""><p>Purpose</p></th>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p><code class=""docutils literal notranslate""><span"
       & " class=""pre"">&#64;param</span></code></p></td>"
       & ASCII.LF
       & "<td><p><code class=""docutils literal notranslate""><span class=""pre"">--</span"
       & ">&#160; <span class=""pre"">&#64;param</span> <span class=""pre"">Name</span>&#1"
       & "60; <span class=""pre"">Description.</span></code></p></td>"
       & ASCII.LF
       & "<td><p>Subprogram formal parameter</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-odd""><td><p><code class=""docutils literal notranslate""><span "
       & "class=""pre"">&#64;parameter</span></code></p></td>"
       & ASCII.LF
       & "<td><p><code class=""docutils literal notranslate""><span class=""pre"">--</span"
       & ">&#160; <span class=""pre"">&#64;parameter</span> <span class=""pre"">Name</span"
       & ">&#160; <span class=""pre"">Description.</span></code></p></td>"
       & ASCII.LF
       & "<td><p>Alias of <code class=""docutils literal notranslate""><span class=""pre"""
       & ">&#64;param</span></code></p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p><code class=""docutils literal notranslate""><span"
       & " class=""pre"">&#64;return</span></code></p></td>"
       & ASCII.LF
       & "<td><p><code class=""docutils literal notranslate""><span class=""pre"">--</span"
       & ">&#160; <span class=""pre"">&#64;return</span> <span class=""pre"">Description.<"
       & "/span></code></p></td>"
       & ASCII.LF
       & "<td><p>Function return value</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-odd""><td><p><code class=""docutils literal notranslate""><span "
       & "class=""pre"">&#64;returns</span></code></p></td>"
       & ASCII.LF
       & "<td><p><code class=""docutils literal notranslate""><span class=""pre"">--</span"
       & ">&#160; <span class=""pre"">&#64;returns</span> <span class=""pre"">Description."
       & "</span></code></p></td>"
       & ASCII.LF
       & "<td><p>Alias of <code class=""docutils literal notranslate""><span class=""pre"""
       & ">&#64;return</span></code></p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p><code class=""docutils literal notranslate""><span"
       & " class=""pre"">&#64;field</span></code></p></td>"
       & ASCII.LF
       & "<td><p><code class=""docutils literal notranslate""><span class=""pre"">--</span"
       & ">&#160; <span class=""pre"">&#64;field</span> <span class=""pre"">Description.</"
       & "span></code></p></td>"
       & ASCII.LF
       & "<td><p>Record component</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-odd""><td><p><code class=""docutils literal notranslate""><span "
       & "class=""pre"">&#64;formal</span></code></p></td>"
       & ASCII.LF
       & "<td><p><code class=""docutils literal notranslate""><span class=""pre"">--</span"
       & ">&#160; <span class=""pre"">&#64;formal</span> <span class=""pre"">Name</span>&#"
       & "160; <span class=""pre"">Description.</span></code></p></td>"
       & ASCII.LF
       & "<td><p>Generic formal parameter</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p><code class=""docutils literal notranslate""><span"
       & " class=""pre"">&#64;brief</span></code></p></td>"
       & ASCII.LF
       & "<td><p><code class=""docutils literal notranslate""><span class=""pre"">--</span"
       & ">&#160; <span class=""pre"">&#64;brief</span> <span class=""pre"">Summary.</span"
       & "></code></p></td>"
       & ASCII.LF
       & "<td><p>Short summary; marks a subprogram documented</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-odd""><td><p><code class=""docutils literal notranslate""><span "
       & "class=""pre"">&#64;summary</span></code></p></td>"
       & ASCII.LF
       & "<td><p><code class=""docutils literal notranslate""><span class=""pre"">--</span"
       & ">&#160; <span class=""pre"">&#64;summary</span> <span class=""pre"">Description."
       & "</span></code></p></td>"
       & ASCII.LF
       & "<td><p>Summary; marks a subprogram documented</p></td>"

       & """136"":{""body"":""src/\\n|-- adacovex_main.adb -- CLI entry point: parse -> pip"
       & "eline -> render -> exit\\n|-- adacovex.ads -- Version constant\\n|-- core/ -"
       & "- config parsing, types, cache, VCS, GNATprove runner, diff\\n|-- parsers/ -"
       & "- input parsing: Ada source, gnatprove.out, tests, manifest, HLR/LLR\\n|-- r"
       & "enderers/ -- output: ANSI, HTML dashboard, Markdown, SVG badges, SBOM, man p"
       & "age\\n|-- compliance/ -- DO-178C DAL assessment logic\\n|-- server/ -- HTTP/"

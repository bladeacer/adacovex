       & ASCII.LF
       & "<li><p><strong>Java</strong>: <code class=""docutils literal notranslate""><sp"
       & "an class=""pre"">.java</span></code></p></li>"
       & ASCII.LF
       & "<li><p><strong>Ruby</strong>: <code class=""docutils literal notranslate""><sp"
       & "an class=""pre"">.rb</span></code></p></li>"
       & ASCII.LF
       & "<li><p><strong>PHP</strong>: <code class=""docutils literal notranslate""><spa"
       & "n class=""pre"">.php</span></code></p></li>"
       & ASCII.LF
       & "<li><p><strong>Swift</strong>: <code class=""docutils literal notranslate""><s"
       & "pan class=""pre"">.swift</span></code></p></li>"
       & ASCII.LF
       & "<li><p><strong>Kotlin</strong>: <code class=""docutils literal notranslate""><"
       & "span class=""pre"">.kt</span></code>, <code class=""docutils literal notranslat"
       & "e""><span class=""pre"">.kts</span></code></p></li>"
       & ASCII.LF
       & "<li><p><strong>Scala</strong>: <code class=""docutils literal notranslate""><s"

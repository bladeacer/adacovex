       & "/"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & ":parameter"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & " count as parameters, "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & ":return"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & "/"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & ":returns"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & " mark a"
       & ASCII.LF
       & "documented return value, and "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & ":type"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(157)
       & "/"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(156)
       & ":rtype"

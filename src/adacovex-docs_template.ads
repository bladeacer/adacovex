       & ASCII.LF
       & "<table class=""docutils align-default"">"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr class=""row-odd""><th class=""head""><p>DAL</p></th>"
       & ASCII.LF
       & "<th class=""head""><p>Requirement</p></th>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p>A"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "C</p></td>"
       & ASCII.LF
       & "<td><p>All high-level requirements (HLRs) traced to source code tags (<code "
       & "class=""docutils literal notranslate""><span class=""pre"">--</span> <span class"
       & "=""pre"">HLR-XXXX</span></code>)</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-odd""><td><p>D"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "E</p></td>"
       & ASCII.LF
       & "<td><p>Recommended but not enforced</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "</tbody>"
       & ASCII.LF
       & "</table>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""orphan-tags"">"
       & ASCII.LF
       & "<h3>2. Orphan Tags<a class=""headerlink"" href=""#orphan-tags"" title=""Link to t"
       & "his heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<div class=""table-wrapper colwidths-auto docutils container"">"
       & ASCII.LF
       & "<table class=""docutils align-default"">"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr class=""row-odd""><th class=""head""><p>DAL</p></th>"
       & ASCII.LF
       & "<th class=""head""><p>Requirement</p></th>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p>A"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "C</p></td>"
       & ASCII.LF

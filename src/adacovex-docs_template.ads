       & "an></code>"
       & ASCII.LF
       & "(visible in each workflow"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s summary table).</p></li>"
       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""test-suite"">"
       & ASCII.LF
       & "<h2>Test Suite<a class=""headerlink"" href=""#test-suite"" title=""Link to this h"
       & "eading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h2>"
       & ASCII.LF
       & "<p>886 tests passing (was 865) across 14 categories: the CLI config category"

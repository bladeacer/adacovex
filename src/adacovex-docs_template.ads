       & "10x10px</span></code> so they no longer dominate the label.</p>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""c6-footer-simplified-and-credits-moved-to-dedicated-tab"">"
       & ASCII.LF
       & "<h3>C6: Footer simplified and credits moved to dedicated tab<a class=""header"
       & "link"" href=""#c6-footer-simplified-and-credits-moved-to-dedicated-tab"" title="
       & """Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<p>The footer is now a single centred line:"
       & ASCII.LF
       & "<code class=""docutils literal notranslate""><span class=""pre"">Generated</span"
       & "> <span class=""pre"">by</span> <span class=""pre"">adacovex</span> <span class="
       & """pre"">-</span> <span class=""pre"">Embed:</span> <span class=""pre"">?theme=ligh"
       & "t|dark|system</span> <span class=""pre"">-</span> <span class=""pre"">Tabs:</spa"

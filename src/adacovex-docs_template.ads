       & ASCII.LF
       & "<li><p><code class=""docutils literal notranslate""><span class=""pre"">tools/bu"
       & "mp-version.py</span></code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " the whole <code class=""docutils literal notranslate""><span class=""pre"">make"
       & "</span> <span class=""pre"">bump-version</span></code> recipe"
       & ASCII.LF
       & "(manifest rewrites, release-file/index scaffolding, changelog"
       & ASCII.LF

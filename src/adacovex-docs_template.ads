       & ASCII.LF
       & "<table class=""docutils align-default"">"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr class=""row-odd""><th class=""head""><p>ASIL</p></th>"
       & ASCII.LF
       & "<th class=""head""><p>Requirement</p></th>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr class=""row-even""><td><p>A"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & "D</p></td>"
       & ASCII.LF
       & "<td><p>All high-level requirements (HLRs) traced to source-code tags (<code "
       & "class=""docutils literal notranslate""><span class=""pre"">--</span> <span class"
       & "=""pre"">HLR-XXXX</span></code>)</p></td>"
       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-odd""><td><p>QM</p></td>"

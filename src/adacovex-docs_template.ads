       & "directory "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " e.g. the base snapshot under <code class=""docutils literal notranslate""><sp"
       & "an class=""pre"">/tmp/adacovex-diff-&lt;pid&gt;</span></code> "
       & Character'Val(226)

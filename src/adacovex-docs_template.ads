       & ASCII.LF
       & "<li><code>HLR-SCAN</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " H8 the string-literal HLR-tag fix (tags inside strings are"
       & ASCII.LF
       & "data, not traces).</li>"
       & ASCII.LF
       & "<li><code>HLR-DOC</code> "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " H11 the font-link drop that works on subpages (HTML tags"
       & ASCII.LF
       & "wrapped in inline code so <code>mdbook</code> stops warning on the unclosed "

       & "<ul class=""simple"">"
       & ASCII.LF
       & "<li><p><strong>Part of Speech:</strong> Noun</p></li>"
       & ASCII.LF
       & "<li><p><strong>Definition:</strong> A named unit of executable code in Ada. "
       & "A subprogram is"
       & ASCII.LF

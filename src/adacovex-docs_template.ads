       & ASCII.LF
       & "</ul>"
       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""technical-name-aspect"">"
       & ASCII.LF
       & "<h4>Technical Name: Aspect<a class=""headerlink"" href=""#technical-name-aspect"

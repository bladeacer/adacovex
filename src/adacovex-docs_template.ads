       & "                        <h1 id=""adacovexparsersdo178c""><a class=""header"" hre"
       & "f=""#adacovexparsersdo178c"">Adacovex.Parsers.DO178C</a></h1>"
       & ASCII.LF
       & "<p>Parser for DO-178C requirements documents."
       & ASCII.LF
       & "Reads HLR.md and LLR.md markdown files, extracts HLR/LLR identifiers"
       & ASCII.LF
       & "and descriptions, and matches HLR tags found in source code."
       & ASCII.LF
       & "HLR-COMPLIANCE: HLR/LLR parsing</p>"
       & ASCII.LF
       & "<p><strong>See also:</strong> <a href=""adacovex-dal-levels.html"">DAL Levels<"
       & "/a> | <a href=""adacovex-docstring-spec.html#hlr-traceability-tags"">Docstring"
       & " Spec "
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(147)
       & " HLR tags</a></p>"
       & ASCII.LF
       & "<blockquote>"
       & ASCII.LF
       & "<p><strong>Note:</strong> All items in this package are public.</p>"
       & ASCII.LF
       & "</blockquote>"
       & ASCII.LF
       & "<h2 id=""types""><a class=""header"" href=""#types"">Types</a></h2>"
       & ASCII.LF
       & "<h3 id=""type-hlr_info""><a class=""header"" href=""#type-hlr_info"">type HLR_Info"
       & "</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type HLR_Info is record"
       & ASCII.LF
       & "Id     : String (1 .. Types.Max_Id_Str);"
       & ASCII.LF
       & "Id_Len : Natural := 0;"
       & ASCII.LF
       & "Desc   : String (1 .. Types.Max_Desc_Str);"
       & ASCII.LF
       & "D_Len  : Natural := 0;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h3 id=""type-llr_info""><a class=""header"" href=""#type-llr_info"">type LLR_Info"
       & "</a></h3>"
       & ASCII.LF
       & "<pre><code class=""language-ada"">type LLR_Info is record"
       & ASCII.LF
       & "Id      : String (1 .. Types.Max_Id_Str);"
       & ASCII.LF
       & "Id_Len  : Natural := 0;"
       & ASCII.LF
       & "HLR_Ref : String (1 .. Types.Max_Id_Str);"
       & ASCII.LF
       & "HLR_Len : Natural := 0;"
       & ASCII.LF
       & "Desc    : String (1 .. Types.Max_Desc_Str);"
       & ASCII.LF
       & "D_Len   : Natural := 0;"
       & ASCII.LF
       & "end record;"
       & ASCII.LF
       & "</code></pre>"
       & ASCII.LF
       & "<h2 id=""functions""><a class=""header"" href=""#functions"">Functions</a></h2>"
       & ASCII.LF
       & "<h3 id=""function-find_hlr_in_source-hlr_id--standardstring-packages--adacove"
       & "xtypesimplementationpackage_vectorsvector-return-standardboolean-global""><a "
       & "class=""header"" href=""#function-find_hlr_in_source-hlr_id--standardstring-pac"
       & "kages--adacovextypesimplementationpackage_vectorsvector-return-standardboole"
       & "an-global"">function Find_HLR_In_Source (HLR_Id : Standard.String; Packages :"
       & " Adacovex.Types.Implementation.Package_Vectors.Vector) return Standard.Boole"
       & "an <code>[Global]</code></a></h3>"
       & ASCII.LF
       & "<div class=""table-wrapper"">"
       & ASCII.LF
       & "<table>"
       & ASCII.LF
       & "<thead>"
       & ASCII.LF
       & "<tr><th>Parameter</th><th>Description</th></tr>"
       & ASCII.LF
       & "</thead>"
       & ASCII.LF
       & "<tbody>"
       & ASCII.LF
       & "<tr><td><code>HLR_Id</code></td><td>HLR identifier to search for.</td></tr>"
       & ASCII.LF
       & "<tr><td><code>Packages</code></td><td>Vector of scanned packages.</td></tr>"
       & ASCII.LF
       & "</tbody>"
       & ASCII.LF
       & "</table>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF
       & "<p><strong>Returns:</strong> True if HLR_Id appears as a source-code tag in "
       & "any package.</p>"
       & ASCII.LF

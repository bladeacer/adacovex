       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""h6-mdbook-detected-as-a-system-dev-dependency"">"
       & ASCII.LF
       & "<h3>H6: mdbook detected as a system dev dependency<a class=""headerlink"" href"
       & "=""#h6-mdbook-detected-as-a-system-dev-dependency"" title=""Link to this headin"
       & "g"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h3>"
       & ASCII.LF
       & "<p>The SBOM"
       & Character'Val(226)

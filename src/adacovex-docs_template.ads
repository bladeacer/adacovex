       & ASCII.LF
       & "</section>"
       & ASCII.LF
       & "<section id=""h2-stale-python-checker-references-purged-from-docs"">"
       & ASCII.LF
       & "<h3>H2: Stale Python-checker references purged from docs<a class=""headerlink"
       & """ href=""#h2-stale-python-checker-references-purged-from-docs"" title=""Link to"
       & " this heading"">"

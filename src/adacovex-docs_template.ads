       & ASCII.LF
       & "</tr>"
       & ASCII.LF
       & "<tr class=""row-odd""><td><p>ISO 26262</p></td>"
       & ASCII.LF
       & "<td><p><code class=""docutils literal notranslate""><span class=""pre"">--asil=<"
       & "/span></code></p></td>"
       & ASCII.LF

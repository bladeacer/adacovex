       & ASCII.LF
       & "<p>The deleted text was the dependency link check in <code class=""docutils l"
       & "iteral notranslate""><span class=""pre"">details.js</span></code>:</p>"
       & ASCII.LF
       & "<div class=""highlight-default notranslate""><div class=""highlight""><pre><span"
       & "></span>if (d.website &amp;&amp; /^https?:\/\//i.test(String(d.website))) {"
       & ASCII.LF
       & "</pre></div>"
       & ASCII.LF
       & "</div>"
       & ASCII.LF

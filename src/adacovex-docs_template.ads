       & """docutils literal notranslate""><span class=""pre"">Post</span> <span class=""pr"
       & "e"">=&gt;</span> <span class=""pre"">Result'Length</span> <span class=""pre"">&lt"
       & ";=</span> <span class=""pre"">6*S'Length</span></code>;"
       & ASCII.LF
       & "body annotated <code class=""docutils literal notranslate""><span class=""pre"">"

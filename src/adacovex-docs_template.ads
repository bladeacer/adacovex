       & ASCII.LF
       & "<section id=""mapping-to-the-shared-rigor-tier"">"
       & ASCII.LF
       & "<h2>Mapping to the shared rigor tier<a class=""headerlink"" href=""#mapping-to-"
       & "the-shared-rigor-tier"" title=""Link to this heading"">"
       & Character'Val(194)
       & Character'Val(182)
       & "</a></h2>"
       & ASCII.LF
       & "<p>IEC 62304 safety classes map onto the same A"
       & Character'Val(226)
       & Character'Val(128)

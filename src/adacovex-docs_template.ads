       & ASCII.LF
       & "scroll-region contract, and both <code class=""docutils literal notranslate"">"
       & "<span class=""pre"">make</span> <span class=""pre"">run-ada-crdt</span></code> a"
       & "nd Ada_CRDT"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s own"
       & ASCII.LF
       & "<code class=""docutils literal notranslate""><span class=""pre"">make</span> <sp"
       & "an class=""pre"">prove</span></code> run through the patched copy, preserving "
       & "the target"
       & Character'Val(226)
       & Character'Val(128)
       & Character'Val(153)
       & "s proof"
       & ASCII.LF
       & "(576 VCs, Platinum, DAL-C, 0 unproved). The merge engine is covered by the"
       & ASCII.LF
       & "new <code class=""docutils literal notranslate""><span class=""pre"">Proof</span"

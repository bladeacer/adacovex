with Adacovex.Prove;
with Adacovex.CPUs;
with Ada.Directories;
with Ada.Streams;
with Ada.Streams.Stream_IO;
with Ada.Text_IO;
with Ada.Strings.Unbounded; use Ada.Strings.Unbounded;

package body Adacovex_Prove_Runner_Tests is

   Fixture_Dir : constant String :=
     Adacovex.CPUs.Get_Temp_Directory & "/adacovex_prove_runner_test";
   Missing_Dir : constant String :=
     Adacovex.CPUs.Get_Temp_Directory & "/adacovex_prove_runner_missing";

   --  True when Needle appears in Haystack.
   --  @param Haystack  String to search.
   --  @param Needle  Substring to look for.
   --  @return True when the substring is present.
   function Has_Text (Haystack : String; Needle : String) return Boolean is
   begin
      if Needle'Length = 0 or else Needle'Length > Haystack'Length then
         return False;
      end if;
      for I in Haystack'First .. Haystack'Last - Needle'Length + 1 loop
         if Haystack (I .. I + Needle'Length - 1) = Needle then
            return True;
         end if;
      end loop;
      return False;
   end Has_Text;

   --  Count the non-overlapping occurrences of Needle in Haystack.
   --  @param Haystack  String to search.
   --  @param Needle  Substring to look for.
   --  @return How many times Needle appears.
   function Count_Text (Haystack : String; Needle : String) return Natural is
      Ct : Natural := 0;
      I  : Natural := Haystack'First;
   begin
      if Needle'Length = 0 or else Needle'Length > Haystack'Length then
         return 0;
      end if;
      while I <= Haystack'Last - Needle'Length + 1 loop
         if Haystack (I .. I + Needle'Length - 1) = Needle then
            Ct := Ct + 1;
            I := I + Needle'Length;
         else
            I := I + 1;
         end if;
      end loop;
      return Ct;
   end Count_Text;

   --  Create an empty file.
   --  @param Path  File path to create.
   procedure Touch (Path : String) is
      F : Ada.Text_IO.File_Type;
   begin
      Ada.Text_IO.Create (F, Ada.Text_IO.Out_File, Path);
      Ada.Text_IO.Close (F);
   end Touch;

   --  Read a whole file byte for byte. The bytes are taken as they are, so
   --  the exact tail of the file survives: Ada.Text_IO never hands back a
   --  trailing empty line, and the replay closes with one.
   --  @param Path  File path to read.
   --  @return The file content, line feeds included.
   function Slurp (Path : String) return Unbounded_String is
      use Ada.Streams;

      F    : Stream_IO.File_Type;
      B    : Stream_Element_Array (1 .. 4096);
      Last : Stream_Element_Offset;
      R    : Unbounded_String := Null_Unbounded_String;
   begin
      Stream_IO.Open (F, Stream_IO.In_File, Path);
      while not Stream_IO.End_Of_File (F) loop
         Stream_IO.Read (F, B, Last);
         for I in B'First .. Last loop
            Append (R, Character'Val (B (I)));
         end loop;
      end loop;
      Stream_IO.Close (F);
      return R;
   end Slurp;

   --  Write a captured gnatprove output file in the shapes the quiet
   --  replay has to sort: phase banners, tagged notice blocks with their
   --  continuation lines, an error block with a code excerpt, a warning,
   --  and the two closing lines of a successful run.
   --  @param Path  File path to write.
   procedure Write_Capture (Path : String) is
      F : Ada.Text_IO.File_Type;
   begin
      Ada.Text_IO.Create (F, Ada.Text_IO.Out_File, Path);
      Ada.Text_IO.Put_Line
        (F, "Phase 1 of 3: generation of data representation information ...");
      Ada.Text_IO.Put_Line (F, "Phase 3 of 3: flow analysis and proof ...");
      Ada.Text_IO.Put_Line (F, "");
      Ada.Text_IO.Put_Line
        (F,
         " info: local subprogram ""Parse_Natural"" only analyzed in the"
         & " context of calls [info-unrolling-inlining]");
      Ada.Text_IO.Put_Line (F, "--> adacovex-cpus.adb:17:13");
      Ada.Text_IO.Put_Line
        (F, "      + add a contract to analyze it separately");
      Ada.Text_IO.Put_Line (F, "");
      Ada.Text_IO.Put_Line
        (F, " info: another notice [info-unrolling-inlining]");
      Ada.Text_IO.Put_Line (F, "--> adacovex-config.adb:42:7");
      Ada.Text_IO.Put_Line
        (F, "      + add a contract to analyze it separately");
      Ada.Text_IO.Put_Line (F, "");
      Ada.Text_IO.Put_Line
        (F, " error: cannot use call to function ""F"" as a statement");
      Ada.Text_IO.Put_Line (F, "--> main.adb:4:07");
      Ada.Text_IO.Put_Line (F, "    4 |       Bad.F (1);");
      Ada.Text_IO.Put_Line (F, "      |       ~~~^~");
      Ada.Text_IO.Put_Line
        (F, "      + return value of a function call cannot be ignored");
      Ada.Text_IO.Put_Line
        (F, "gnatprove: error during generation of Global contracts");
      Ada.Text_IO.Put_Line (F, "warning: no checks generated by GNATprove");
      Ada.Text_IO.Put_Line (F, "Success: all checks proved (1054 checks).");
      Ada.Text_IO.Put_Line
        (F, "Summary logged in obj/gnatprove/gnatprove.out");
      Ada.Text_IO.Close (F);
   end Write_Capture;

   --  Write a captured gnatprove output file in the shape of a failing run:
   --  two unproved prover checks (one with a severity word, one without) and
   --  a flow finding that names an uninitialized object, followed by the
   --  closing summary line.
   --  @param Path  File path to write.
   procedure Write_Failing_Capture (Path : String) is
      F : Ada.Text_IO.File_Type;
   begin
      Ada.Text_IO.Create (F, Ada.Text_IO.Out_File, Path);
      Ada.Text_IO.Put_Line (F, "Phase 3 of 3: flow analysis and proof ...");
      Ada.Text_IO.Put_Line
        (F, "adacovex-types.adb:54:08: medium: postcondition might fail");
      Ada.Text_IO.Put_Line
        (F, "adacovex-prove.adb:120:14: range check might fail");
      Ada.Text_IO.Put_Line
        (F, "adacovex-source.adb:31:05: ""X"" is not initialized");
      Ada.Text_IO.Put_Line
        (F, "Summary logged in obj/gnatprove/gnatprove.out");
      Ada.Text_IO.Close (F);
   end Write_Failing_Capture;

   --  Write a captured gnatprove stream in the shape the prover really
   --  emits: the message on its own line, the location on a `-->` line, an
   --  excerpt, a caret ruler, and a `+` sub-message that says the provers
   --  gave up. A second block carries no sub-message, and a third finding
   --  uses the single-line flow shape.
   --  @param Path  File path to write.
   procedure Write_Prover_Blocks (Path : String) is
      F : Ada.Text_IO.File_Type;
   begin
      Ada.Text_IO.Create (F, Ada.Text_IO.Out_File, Path);
      Ada.Text_IO.Put_Line (F, "Phase 3 of 3: flow analysis and proof ...");
      Ada.Text_IO.Put_Line (F, " medium: index check might fail");
      Ada.Text_IO.Put_Line (F, "--> prove_diag_broken.adb:12:14");
      Ada.Text_IO.Put_Line (F, "   12 |      return T (I);");
      Ada.Text_IO.Put_Line (F, "      |             ^~~~~");
      Ada.Text_IO.Put_Line
        (F, "      + provers gave up before completing the proof");
      Ada.Text_IO.Put_Line (F, "");
      Ada.Text_IO.Put_Line (F, " medium: postcondition might fail");
      Ada.Text_IO.Put_Line (F, "--> prove_diag_broken.ads:10:19");
      Ada.Text_IO.Put_Line (F, "   10 |      Post => Doubled'Result = 2 * X;");
      Ada.Text_IO.Put_Line (F, "");
      Ada.Text_IO.Put_Line
        (F, "prove_diag_flow.adb:5:04: ""X"" is not" & " initialized");
      Ada.Text_IO.Put_Line
        (F, "Summary logged in obj/gnatprove/gnatprove.out");
      Ada.Text_IO.Close (F);
   end Write_Prover_Blocks;

   --  Write a captured gnatprove stream in which the prover repeats one
   --  warning block three times (one copy per inlined call site) and reports
   --  one unproved check twice at the same location.
   --  @param Path  File path to write.
   procedure Write_Repeated_Capture (Path : String) is
      F : Ada.Text_IO.File_Type;
      W : constant String :=
        "crdt-lms.adb:155:07: warning: ""Ctx"" is set by ""Final"" but not"
        & " used after the call";
   begin
      Ada.Text_IO.Create (F, Ada.Text_IO.Out_File, Path);
      Ada.Text_IO.Put_Line (F, W);
      Ada.Text_IO.Put_Line (F, "--> crdt-lms.adb:155:07");
      Ada.Text_IO.Put_Line (F, "  155 |       Final (Ctx);");
      Ada.Text_IO.Put_Line (F, "");
      Ada.Text_IO.Put_Line (F, W);
      Ada.Text_IO.Put_Line (F, "--> crdt-lms.adb:155:07");
      Ada.Text_IO.Put_Line (F, "  155 |       Final (Ctx);");
      Ada.Text_IO.Put_Line (F, "");
      Ada.Text_IO.Put_Line (F, W);
      Ada.Text_IO.Put_Line (F, "--> crdt-lms.adb:155:07");
      Ada.Text_IO.Put_Line (F, "  155 |       Final (Ctx);");
      Ada.Text_IO.Put_Line (F, "");
      Ada.Text_IO.Put_Line (F, "crdt-lms.adb:160:09: index check might fail");
      Ada.Text_IO.Put_Line (F, "crdt-lms.adb:160:09: index check might fail");
      Ada.Text_IO.Close (F);
   end Write_Repeated_Capture;

   procedure Run (R : in out Adacovex.Test_Support.Runner'Class) is
      O   : Adacovex.Prove.Prove_Options;
      GPR : String (1 .. 512);
      Len : Natural;
      OK  : Boolean;

      --  Rebuild the fixture directory with exactly the listed .gpr files.
      --  @param First_GPR  Name of the first project file to create.
      --  @param Second_GPR  Name of a second project file ("" for none).
      procedure Fixture (First_GPR : String; Second_GPR : String := "") is
      begin
         if Ada.Directories.Exists (Fixture_Dir) then
            Ada.Directories.Delete_Tree (Fixture_Dir);
         end if;
         Ada.Directories.Create_Directory (Fixture_Dir);
         if First_GPR'Length > 0 then
            Touch (Fixture_Dir & "/" & First_GPR);
         end if;
         if Second_GPR'Length > 0 then
            Touch (Fixture_Dir & "/" & Second_GPR);
         end if;
      end Fixture;
   begin
      --  Defaults: auto-detected jobs, the default step budget, and loop
      --  unrolling always disabled.
      R.Check
        (Adacovex.Prove.Detect_Core_Count >= 1,
         "the detected core count is at least one");

      --  The generated bundle specs carry no proof surface and are excluded
      --  from the proof-input hash, so a docs or dashboard regeneration does
      --  not invalidate the cached proof. Every other source file is in.
      R.Check
        (not Adacovex.Prove.Is_Proof_Input ("adacovex-docs_template.ads"),
         "the bundled manual spec is excluded from the proof input");
      R.Check
        (not Adacovex.Prove.Is_Proof_Input ("adacovex-dashboard_template.ads"),
         "the dashboard template spec is excluded from the proof input");
      R.Check
        (Adacovex.Prove.Is_Proof_Input ("adacovex-prove.adb"),
         "an ordinary project body is part of the proof input");
      R.Check
        (Adacovex.Prove.Is_Proof_Input ("adacovex-prove.ads"),
         "an ordinary project spec is part of the proof input");
      R.Check
        (Adacovex.Prove.Is_Proof_Input ("adacovex-docs_template.adb"),
         "the hand-written manual decoder body stays in the proof input");
      R.Check
        (Adacovex.Prove.Is_Proof_Input ("docs_template.ads"),
         "only the exact generated base name is excluded");
      R.Check
        (Adacovex.Prove.Is_Proof_Input ("Adacovex-Docs_Template.ads"),
         "the exclusion match is case-sensitive");
      R.Check
        (Adacovex.Prove.Is_Proof_Input (""),
         "an empty name counts as an ordinary source file");

      declare
         S : constant String := Adacovex.Prove.Build_Option_String (O, 8);
      begin
         R.Check
           (S = "-j 8 --steps 10000 --no-loop-unrolling",
            "the default option string is jobs, steps, no-unrolling");
      end;

      --  Zero jobs is forwarded as-is (all cores).
      declare
         S : constant String := Adacovex.Prove.Build_Option_String (O, 0);
      begin
         R.Check (Has_Text (S, "-j 0"), "-j0 forwards every core");
      end;

      --  Every configured option is forwarded, in a stable order.
      O.Jobs := 4;
      O.Level := 3;
      O.Timeout := 60;
      O.Steps := 2000;
      O.Memlimit := 1500;
      O.Force := True;
      O.No_Inlining := True;
      declare
         S : constant String := Adacovex.Prove.Build_Option_String (O, 4);
      begin
         R.Check
           (S
            = "-j 4 --level 3 --timeout 60 --steps 2000 --memlimit 1500"
              & " -f --no-loop-unrolling --no-inlining",
            "the configured option string carries every switch in order");
      end;

      --  An explicit --steps value replaces the default budget.
      R.Check
        (Has_Text (Adacovex.Prove.Build_Option_String (O, 4), "--steps 2000"),
         "an explicit step budget replaces the default");

      --  Maximum proof effort: --level=4 forwards unchanged, so a gnatprove
      --  level-4 run (the deepest flow analysis) is reproducible from the
      --  same option string the runner builds.
      declare
         L4 : Adacovex.Prove.Prove_Options := O;
      begin
         L4.Level := 4;
         declare
            S : constant String := Adacovex.Prove.Build_Option_String (L4, 8);
         begin
            R.Check
              (Has_Text (S, "--level 4"),
               "--level=4 forwards as the maximum proof effort");
            R.Check
              (Has_Text (S, "--steps 2000"),
               "the level-4 string keeps an explicit step budget");
            R.Check
              (Has_Text (S, "--no-loop-unrolling"),
               "the level-4 string still disables loop unrolling");
         end;
      end;

      --  Level 0 (fastest, least effort) also forwards unchanged, so the
      --  full 0..4 effort range is reproducible.
      declare
         L0 : Adacovex.Prove.Prove_Options := O;
      begin
         L0.Level := 0;
         R.Check
           (Has_Text (Adacovex.Prove.Build_Option_String (L0, 8), "--level 0"),
            "--level=0 forwards as the lowest proof effort");
      end;

      --  Raw --args passthrough lands after the built options.
      O.Extra_Args := To_Unbounded_String ("--counterexamples=on");
      declare
         S : constant String := Adacovex.Prove.Build_Option_String (O, 4);
      begin
         R.Check
           (Has_Text (S, "--counterexamples=on"),
            "the raw --args value is appended verbatim");
         R.Check
           (Has_Text (S, "--no-inlining --counterexamples=on"),
            "the raw --args value follows the built options");
      end;

      --  Root GPR lookup: a directory with no project file has none.
      Fixture ("");
      Adacovex.Prove.Find_Root_GPR (Fixture_Dir, GPR, Len, OK);
      R.Check (not OK, "a target without a .gpr reports no root project");

      --  A single project file is the root project.
      Fixture ("single.gpr");
      Adacovex.Prove.Find_Root_GPR (Fixture_Dir, GPR, Len, OK);
      R.Check (OK, "a single .gpr is resolved as the root project");
      R.Check
        (Len > 0 and then GPR (1 .. Len) = Fixture_Dir & "/single.gpr",
         "the resolved root project path is the fixture .gpr");

      --  Two project files are ambiguous: no root project is reported.
      Fixture ("first.gpr", "second.gpr");
      Adacovex.Prove.Find_Root_GPR (Fixture_Dir, GPR, Len, OK);
      R.Check
        (not OK, "two .gpr files are ambiguous and report no root project");

      --  A missing directory reports no root project.
      if Ada.Directories.Exists (Missing_Dir) then
         Ada.Directories.Delete_Tree (Missing_Dir);
      end if;
      Adacovex.Prove.Find_Root_GPR (Missing_Dir, GPR, Len, OK);
      R.Check (not OK, "a missing target directory reports no root project");

      --  The quiet replay turns a captured gnatprove stream into one framed
      --  block: it drops the phase banners, the tagged notice blocks with
      --  their continuation lines, and the orphan blanks those drops leave,
      --  while every actionable line survives and the counts are reported.
      declare
         Replay_Path : constant String := Fixture_Dir & "/replay.txt";
         Stats       : Adacovex.Prove.Replay_Stats;
      begin
         Fixture ("replay.gpr");
         Write_Capture (Fixture_Dir & "/capture.txt");
         Adacovex.Prove.Replay_Suppressed
           (Fixture_Dir & "/capture.txt", "", Replay_Path, Stats);
         declare
            T : constant String := To_String (Slurp (Replay_Path));
         begin
            R.Check
              (not Has_Text (T, "Phase 1 of 3"),
               "the replay drops a phase-progress line");
            R.Check
              (not Has_Text (T, "Phase 3 of 3"),
               "the replay drops every phase-progress line");
            R.Check
              (not Has_Text (T, "[info-unrolling-inlining]"),
               "the replay drops the tagged notice blocks");
            R.Check
              (not Has_Text (T, "add a contract"),
               "no continuation fragment of a dropped notice survives");
            R.Check
              (Has_Text (T, "Success: all checks proved (1054 checks)."),
               "the check result passes through the replay");
            R.Check
              (Has_Text (T, "error: cannot use call to function"),
               "the error message passes through the replay");
            R.Check
              (Has_Text (T, "Bad.F (1);"),
               "the code excerpt of a kept message passes through");
            R.Check
              (Has_Text (T, "warning: no checks generated by GNATprove"),
               "the warning passes through the replay");
            R.Check
              (not Has_Text (T, ASCII.LF & ASCII.LF & ASCII.LF),
               "runs of blank lines collapse to one blank line");
            R.Check
              (T'Length > 0 and then T (T'First) = ASCII.LF,
               "the replay opens with one blank line");
            R.Check
              (T'Length > 1
               and then T (T'Last - 1 .. T'Last) = ASCII.LF & ASCII.LF,
               "the replay closes with one blank line");
            R.Check
              (Has_Text (T, "informational notice(s) hidden"),
               "the footer states how many notices were hidden");
            R.Check
              (Has_Text (T, "filtered:  2"),
               "the footer names the hidden notice count");
         end;
         R.Check (Stats.Hidden = 2, "two suppressed notices are counted");
         R.Check (Stats.Progress = 2, "two phase-progress lines are counted");
         R.Check
           (Stats.Errors = 2, "the error lines of the replay are counted");
         R.Check
           (Stats.Warnings = 1, "the warning lines of the replay are counted");
      end;

      --  A custom suppression set drops only its own tag, and the footer
      --  appears only when something was actually dropped.
      declare
         Replay_Path : constant String := Fixture_Dir & "/replay2.txt";
         Stats       : Adacovex.Prove.Replay_Stats;
      begin
         Fixture ("replay.gpr");
         Write_Capture (Fixture_Dir & "/capture.txt");
         Adacovex.Prove.Replay_Suppressed
           (Fixture_Dir & "/capture.txt", "custom-tag", Replay_Path, Stats);
         declare
            T : constant String := To_String (Slurp (Replay_Path));
         begin
            R.Check
              (Has_Text (T, "[info-unrolling-inlining]"),
               "a custom set leaves the default-set notices in place");
            R.Check
              (not Has_Text (T, "filtered:"),
               "the footer stays silent when no notice matched a set");
         end;
         R.Check (Stats.Hidden = 0, "an unmatched set suppresses nothing");
      end;

      --  The diagnostics pass keeps the source location and the check kind
      --  of every unproved finding, and the block it renders names the
      --  prover, the locations, and the fix hint for the first check.
      declare
         Fail_Path : constant String := Fixture_Dir & "/failures.txt";
         Stats     : Adacovex.Prove.Failure_Stats;
      begin
         Fixture ("replay.gpr");
         Write_Failing_Capture (Fail_Path);
         Adacovex.Prove.Collect_Failures (Fail_Path, Stats);
         R.Check (Stats.Unproved = 3, "three unproved findings are counted");
         R.Check (Stats.Count = 3, "three findings are named");
         R.Check
           (To_String (Stats.Items (1).Location) = "adacovex-types.adb:54:08",
            "a finding keeps its source location");
         R.Check
           (To_String (Stats.Items (1).Kind) = "postcondition",
            "the check kind is read from the message");
         R.Check
           (not Stats.Items (1).Flow, "a prover check is not a flow finding");
         R.Check
           (To_String (Stats.Items (2).Kind) = "range check",
            "a check without a severity word still yields its kind");
         R.Check
           (To_String (Stats.Items (3).Kind) = "initialization",
            "an uninitialized object is reported as an initialization");
         R.Check
           (Stats.Items (3).Flow,
            "an initialization finding is marked as flow analysis");
         declare
            D : constant String :=
              Adacovex.Prove.Diagnostics_Text ("16.1.0", Stats);
         begin
            R.Check
              (Has_Text (D, "3 unproved check(s)"),
               "the block states how many checks are unproved");
            R.Check
              (Has_Text (D, "prover 16.1.0"),
               "the block names the prover identity");
            R.Check
              (Has_Text (D, "adacovex-types.adb:54:08  postcondition"),
               "the block points at the source location and its kind");
            R.Check
              (Has_Text (D, "(flow analysis)"),
               "the block marks a flow finding");
            R.Check (Has_Text (D, "fix:"), "the block carries a fix hint");
            R.Check
              (Has_Text (D, "loop invariant or the postcondition"),
               "the fix hint matches the first check's kind");
         end;
      end;

      --  A clean capture names nothing, and a run with no finding renders no
      --  block at all.
      declare
         Clean_Path : constant String := Fixture_Dir & "/clean.txt";
         Stats      : Adacovex.Prove.Failure_Stats;
      begin
         Fixture ("replay.gpr");
         Write_Capture (Clean_Path);
         Adacovex.Prove.Collect_Failures (Clean_Path, Stats);
         R.Check
           (Stats.Unproved = 0 and then Stats.Count = 0,
            "a clean capture reports no finding");
         R.Check
           (Adacovex.Prove.Diagnostics_Text ("16.1.0", Stats) = "",
            "a run with no finding renders no diagnostics block");
      end;

      --  More findings than the block names are all counted, and the block
      --  says how many it left out.
      declare
         Many_Path : constant String := Fixture_Dir & "/many.txt";
         Stats     : Adacovex.Prove.Failure_Stats;
         F         : Ada.Text_IO.File_Type;
      begin
         Fixture ("replay.gpr");
         Ada.Text_IO.Create (F, Ada.Text_IO.Out_File, Many_Path);
         for I in 1 .. 10 loop
            Ada.Text_IO.Put_Line
              (F,
               "unit"
               & Natural'Image (I)
               & ".adb:1:1: index check might fail");
         end loop;
         Ada.Text_IO.Close (F);
         Adacovex.Prove.Collect_Failures (Many_Path, Stats);
         R.Check
           (Stats.Unproved = 10, "every finding is counted, not only shown");
         R.Check
           (Stats.Count = Adacovex.Prove.Max_Failure_Items,
            "the block names at most Max_Failure_Items findings");
         R.Check
           (Has_Text
              (Adacovex.Prove.Diagnostics_Text ("", Stats),
               "2 more (--verbose lists every check)"),
            "the block says how many findings it left out");
         R.Check
           (Has_Text
              (Adacovex.Prove.Diagnostics_Text ("", Stats),
               "subtype constraint or a precondition"),
            "a plain index finding gets the bound hint");
      end;

      --  A divisor that the precondition does not exclude as zero gets its
      --  own hint: state the non-zero divisor precondition, not a bound.
      declare
         Div_Path : constant String := Fixture_Dir & "/divide.txt";
         Stats    : Adacovex.Prove.Failure_Stats;
         F        : Ada.Text_IO.File_Type;
      begin
         Fixture ("replay.gpr");
         Ada.Text_IO.Create (F, Ada.Text_IO.Out_File, Div_Path);
         Ada.Text_IO.Put_Line
           (F,
            "prove_diag_divide.adb:7:16: medium: divide by zero"
            & " might fail");
         Ada.Text_IO.Close (F);
         Adacovex.Prove.Collect_Failures (Div_Path, Stats);
         R.Check
           (Stats.Unproved = 1
            and then To_String (Stats.Items (1).Kind) = "divide by zero",
            "a divide-by-zero finding keeps its kind");
         R.Check
           (Has_Text
              (Adacovex.Prove.Diagnostics_Text ("", Stats),
               "divisor is non-zero"),
            "a divide-by-zero finding gets the divisor hint");
      end;

      --  The prover's real block shape (message line, `-->` location, and a
      --  `+` sub-message) is what the diagnostics pass reads. A `gave up`
      --  sub-message marks the finding as a budget problem, so its hint
      --  raises --steps instead of naming a missing contract.
      declare
         Block_Path : constant String := Fixture_Dir & "/blocks.txt";
         Stats      : Adacovex.Prove.Failure_Stats;
      begin
         Fixture ("replay.gpr");
         Write_Prover_Blocks (Block_Path);
         Adacovex.Prove.Collect_Failures (Block_Path, Stats);
         R.Check
           (Stats.Unproved = 3, "the real block shape yields three findings");
         R.Check (Stats.Count = 3, "three findings are named");
         R.Check
           (To_String (Stats.Items (1).Kind) = "index check",
            "the message line yields the check kind");
         R.Check
           (To_String (Stats.Items (1).Location)
            = "prove_diag_broken.adb:12:14",
            "the --> line yields the source location");
         R.Check
           (Stats.Items (1).Budget,
            "a gave-up sub-message marks a budget finding");
         R.Check
           (To_String (Stats.Items (2).Kind) = "postcondition",
            "a block without a sub-message still yields its kind");
         R.Check
           (To_String (Stats.Items (2).Location)
            = "prove_diag_broken.ads:10:19",
            "each block keeps its own location");
         R.Check
           (not Stats.Items (2).Budget,
            "only the block that says gave up is a budget finding");
         R.Check
           (To_String (Stats.Items (3).Kind) = "initialization"
            and then Stats.Items (3).Flow,
            "the single-line flow shape still yields an initialization");
         declare
            D : constant String :=
              Adacovex.Prove.Diagnostics_Text ("16.1.0", Stats);
         begin
            R.Check
              (Has_Text (D, "(provers gave up)"),
               "the block marks a budget finding");
            R.Check
              (Has_Text (D, "--steps"),
               "the hint raises the budget for a budget finding");
            R.Check
              (Has_Text (D, "prove_diag_broken.adb:12:14  index check"),
               "the block pairs the location with its kind");
         end;
      end;

      --  A diagnostic the prover repeats (one copy per inlined call site)
      --  is replayed once, counted once, and stated in the duplicates footer.
      declare
         Repeat_Path : constant String := Fixture_Dir & "/repeated.txt";
         Replay_Path : constant String := Fixture_Dir & "/repeated.out";
         Stats       : Adacovex.Prove.Replay_Stats;
      begin
         Fixture ("replay.gpr");
         Write_Repeated_Capture (Repeat_Path);
         Adacovex.Prove.Replay_Suppressed
           (Repeat_Path, "", Replay_Path, Stats);
         declare
            T : constant String := To_String (Slurp (Replay_Path));
         begin
            R.Check
              (Count_Text (T, "not used after the call") = 1,
               "the replay keeps one copy of a repeated warning");
            R.Check
              (Count_Text (T, "155 |       Final (Ctx);") = 1,
               "the replay drops the excerpt of a repeated warning");
            R.Check
              (Has_Text (T, "duplicates:  2"),
               "the footer states how many repeats were collapsed");
         end;
         R.Check
           (Stats.Duplicates = 2, "two repeated warning lines are counted");
         R.Check
           (Stats.Warnings = 1, "a repeated warning is counted once");
      end;

      --  The diagnostics block names and counts one finding per location and
      --  kind, so a check the prover reported twice does not inflate the
      --  unproved count.
      declare
         Repeat_Path : constant String := Fixture_Dir & "/repeated.txt";
         Stats       : Adacovex.Prove.Failure_Stats;
      begin
         Fixture ("replay.gpr");
         Write_Repeated_Capture (Repeat_Path);
         Adacovex.Prove.Collect_Failures (Repeat_Path, Stats);
         R.Check
           (Stats.Unproved = 1, "a repeated finding is counted once");
         R.Check (Stats.Count = 1, "a repeated finding is named once");
         R.Check
           (Count_Text
              (Adacovex.Prove.Diagnostics_Text ("", Stats),
               "crdt-lms.adb:160:09  index check") = 1,
            "the block lists the repeated finding once");
      end;

      Ada.Directories.Delete_Tree (Fixture_Dir);
   end Run;

end Adacovex_Prove_Runner_Tests;
